# Database Configuration
POSTGRES_DB=svxlinkmanager
POSTGRES_USER=svxlink
POSTGRES_PASSWORD=changeme

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Hardware and Daemon Configuration (Development)
# SA818__UseMock: true = Mock SA818 hardware (not available in Docker)
# SvxLink__UseMockDaemon: false = Use real SVXLink daemon installed in container
SA818__UseMock=true
SvxLink__UseMockDaemon=false
