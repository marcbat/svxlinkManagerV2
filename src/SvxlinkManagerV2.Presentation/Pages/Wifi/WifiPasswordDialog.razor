@namespace SvxlinkManagerV2.Presentation.Pages.Wifi
@using SvxlinkManagerV2.Domain.Wifi

@* Formulaire inline de saisie du mot de passe WiFi *@

<div class="wifi-password-dialog">
    <div class="wifi-password-header">
        <span class="material-symbols-outlined">lock</span>
        <span>Connexion à <strong>@Ssid</strong></span>
    </div>
    <div class="wifi-password-body">
        <div class="field-group">
            <label class="field-label">Mot de passe</label>
            <input type="password"
                   class="field-input"
                   placeholder="Mot de passe WiFi"
                   @bind="_password"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp" />
        </div>
        <div class="wifi-password-actions">
            <button class="btn btn-secondary btn-sm" @onclick="OnCancel">
                Annuler
            </button>
            <button class="btn btn-primary btn-sm"
                    @onclick="HandleConnect"
                    disabled="@string.IsNullOrWhiteSpace(_password)">
                <span class="material-symbols-outlined">wifi</span>
                Connecter
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Ssid { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnConnect { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _password = string.Empty;

    private async Task HandleConnect()
    {
        if (!string.IsNullOrWhiteSpace(_password))
            await OnConnect.InvokeAsync(_password);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleConnect();
    }
}
