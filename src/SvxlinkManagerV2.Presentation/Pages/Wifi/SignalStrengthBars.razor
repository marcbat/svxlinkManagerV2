@namespace SvxlinkManagerV2.Presentation.Pages.Wifi

@* Composant affichant les barres de signal WiFi (0 à 4 barres) *@

<div class="signal-bars signal-bars--@Bars" title="Signal : @Signal%">
    <span class="bar bar-1 @(Bars >= 1 ? "active" : "")"></span>
    <span class="bar bar-2 @(Bars >= 2 ? "active" : "")"></span>
    <span class="bar bar-3 @(Bars >= 3 ? "active" : "")"></span>
    <span class="bar bar-4 @(Bars >= 4 ? "active" : "")"></span>
</div>

@code {
    [Parameter] public int Signal { get; set; }
    [Parameter] public int Bars { get; set; }
}
