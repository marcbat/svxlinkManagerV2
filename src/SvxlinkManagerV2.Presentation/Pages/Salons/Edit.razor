@page "/salons/{Id:guid}/editer"
@using SvxlinkManagerV2.Application.Features.Salons.GetSalonById
@using SvxlinkManagerV2.Application.Features.Salons.UpdateSalonConfiguration
@using SvxlinkManagerV2.Application.Features.Salons.UpdateDtmfCode
@using SvxlinkManagerV2.Application.Features.Salons.Sound
@using SvxlinkManagerV2.Application.Interfaces
@using SvxlinkManagerV2.Domain.Aggregates.Salon
@using SvxlinkManagerV2.Domain.Aggregates.Salon.Entities
@using SvxlinkManagerV2.Domain.Common

@inject IMediator Mediator
@inject NavigationManager Nav
@inject ToastService ToastService
@inject IActiveSessionTracker Tracker

<!-- ── Page Header ─────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <a href="/salons" class="back-link">
            <span class="material-symbols-outlined">arrow_back</span>
            Retour aux salons
        </a>
        <h1 class="page-title" style="margin-top:6px">
            @if (_salon is not null)
            {
                <text>Modifier : @_salon.Name</text>
            }
            else
            {
                <text>Modifier le salon</text>
            }
        </h1>
        <p class="page-subtitle">Mise à jour de la configuration radio et réseau du salon.</p>
    </div>
</div>

@if (_isLoading)
{
    <div class="form-layout">
        <div class="form-col">
            <div class="card skeleton-card"><div class="skeleton" style="height:220px"></div></div>
            <div class="card skeleton-card" style="margin-top:18px"><div class="skeleton" style="height:200px"></div></div>
        </div>
        <div class="form-col">
            <div class="card skeleton-card"><div class="skeleton" style="height:280px"></div></div>
        </div>
    </div>
}
else if (_notFound)
{
    <div class="not-found-box">
        <span class="material-symbols-outlined">search_off</span>
        <p>Salon introuvable.</p>
        <a href="/salons" class="btn btn-secondary">Retour à la liste</a>
    </div>
}
else if (_salon is not null)
{
    <!-- Bandeau salon actif -->
    @if (_salonIsActive)
    {
        <div class="alert-active">
            <span class="material-symbols-outlined">lock</span>
            <div>
                <strong>Salon actuellement actif</strong>
                <span>Désactivez le salon avant de modifier sa configuration.</span>
            </div>
        </div>
    }

    <!-- Infos immuables -->
    <div class="card info-bar">
        <div class="info-chip">
            <span class="material-symbols-outlined">badge</span>
            <strong>@_salon.Name</strong>
        </div>
        @if (_salon.IsDefault)
        {
            <span class="badge badge-default">Défaut</span>
        }
        @if (_salon.IsTemporized)
        {
            <span class="badge badge-temp">Temporisé</span>
        }
        @if (_salonIsActive)
        {
            <span class="badge badge-active">Actif</span>
        }
        <span class="info-chip-note">Le nom et les options ne sont pas modifiables ici.</span>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="form-layout">

            <!-- ── Colonne Gauche ──────────────────────────────── -->
            <div class="form-col">

                <!-- Configuration Radio -->
                <div class="card" style="margin-bottom:18px">
                    <div class="section-header">
                        <span class="material-symbols-outlined">settings_input_antenna</span>
                        Configuration Radio
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label class="form-label">Fréquence RX (MHz) <span class="required">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.RxFrequency"
                                         step="0.005" disabled="@_salonIsActive" />
                            <div class="field-hint">30 – 3000 MHz</div>
                            <ValidationMessage For="() => _model.RxFrequency" class="field-error" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Fréquence TX (MHz) <span class="required">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.TxFrequency"
                                         step="0.005" disabled="@_salonIsActive" />
                            <div class="field-hint">30 – 3000 MHz</div>
                            <ValidationMessage For="() => _model.TxFrequency" class="field-error" />
                        </div>
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label class="form-label">CTCSS RX</label>
                            <select class="form-select" @bind="_model.RxCtcssStr" disabled="@_salonIsActive">
                                <option value="">Aucun</option>
                                @foreach (var (freq, label) in _ctcssOptions)
                                {
                                    <option value="@freq.ToString(System.Globalization.CultureInfo.InvariantCulture)">@label</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">CTCSS TX</label>
                            <select class="form-select" @bind="_model.TxCtcssStr" disabled="@_salonIsActive">
                                <option value="">Aucun</option>
                                @foreach (var (freq, label) in _ctcssOptions)
                                {
                                    <option value="@freq.ToString(System.Globalization.CultureInfo.InvariantCulture)">@label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Son d'annonce -->
                <div class="card">
                    <div class="section-header">
                        <span class="material-symbols-outlined">volume_up</span>
                        Son d'annonce
                    </div>

                    <div class="format-hint">
                        <span class="material-symbols-outlined">info</span>
                        Format requis&nbsp;: <strong>WAV · 16 000 Hz · Mono · 16 bits PCM</strong>
                    </div>

                    @if (_soundSummary != null)
                    {
                        <div class="sound-info">
                            <div class="form-group">
                                <label class="form-label">Nom</label>
                                <span class="form-value">@_soundSummary.Name</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Durée</label>
                                <span class="form-value">@FormatDuration(_soundSummary.Duration)</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Fréquence</label>
                                <span class="form-value">@_soundSummary.SampleRate Hz</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Canaux</label>
                                <span class="form-value">@(_soundSummary.Channels == 1 ? "Mono" : "Stéréo")</span>
                            </div>
                            <div class="form-group" style="margin-bottom:0">
                                <label class="form-label">Date de création</label>
                                <span class="form-value">@_soundSummary.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>
                        @if (!_salonIsActive)
                        {
                            <div style="display:flex;gap:8px;margin-top:12px">
                                <label class="btn btn-secondary" style="margin:0">
                                    <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">swap_horiz</span>
                                    Remplacer
                                    <InputFile OnChange="HandleSoundReplace" accept=".wav" style="display:none" />
                                </label>
                                <button type="button" class="btn btn-danger" @onclick="HandleSoundDelete">
                                    <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">delete</span>
                                    Supprimer
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        @if (!_salonIsActive)
                        {
                            <div class="drop-zone @(_isDragOver ? "drop-zone--over" : "")"
                                 @ondragover:preventDefault
                                 @ondragover="() => _isDragOver = true"
                                 @ondragleave="() => _isDragOver = false">
                                <InputFile OnChange="OnSoundFileSelected" accept=".wav" class="drop-input" id="edit-sound-file" />
                                <label for="edit-sound-file" class="drop-label">
                                    <span class="material-symbols-outlined drop-icon">audio_file</span>
                                    @if (_soundFile is null)
                                    {
                                        <span class="drop-text">Glissez un fichier <strong>.wav</strong> ici ou cliquez pour parcourir</span>
                                    }
                                    else
                                    {
                                        <span class="drop-text drop-text--selected">
                                            <span class="material-symbols-outlined" style="font-size:16px;color:var(--success)">check_circle</span>
                                            @_soundFileName
                                        </span>
                                    }
                                </label>
                            </div>

                            @if (_soundFile is not null)
                            {
                                <div class="form-group" style="margin-top:14px;margin-bottom:0">
                                    <label class="form-label">Nom du son</label>
                                    <input class="form-control" @bind="_soundName" @bind:event="oninput"
                                           placeholder="ex: annonce-salon" maxlength="100" />
                                    @if (string.IsNullOrWhiteSpace(_soundName))
                                    {
                                        <span class="field-error">Le nom est obligatoire pour le son.</span>
                                    }
                                </div>

                                <div style="margin-top:12px;display:flex;justify-content:flex-end">
                                    <button type="button" class="btn btn-primary"
                                            disabled="@(string.IsNullOrWhiteSpace(_soundName))"
                                            @onclick="HandleUploadSelectedFile">
                                        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle">upload</span>
                                        Enregistrer le son
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color:var(--text-muted);margin:0">Aucun son configuré</p>
                        }
                    }
                </div>

                <!-- Code DTMF -->
                <div class="card" style="margin-top:18px">
                    <div class="section-header">
                        <span class="material-symbols-outlined">dialpad</span>
                        Commande DTMF
                    </div>
                    <div class="form-group" style="margin-bottom:0">
                        <label class="form-label">Code DTMF</label>
                        <InputNumber class="form-control" @bind-Value="_model.DtmfCode"
                                     placeholder="ex: 96" disabled="@_salonIsActive" />
                        <div class="field-hint">Optionnel, 1 – 9999. Permet de changer de salon par commande radio.</div>
                        <ValidationMessage For="() => _model.DtmfCode" class="field-error" />
                    </div>
                </div>

            </div>

            <!-- ── Colonne Droite ──────────────────────────────── -->
            <div class="form-col">

                <!-- Configuration Réseau -->
                <div class="card" style="margin-bottom:18px">
                    <div class="section-header">
                        <span class="material-symbols-outlined">lan</span>
                        Configuration Réseau (Reflector)
                    </div>

                    <div class="form-group">
                        <label class="form-label">Hôte <span class="required">*</span></label>
                        <InputText class="form-control" @bind-Value="_model.Host"
                                   placeholder="ex: rrf.music-all.fr" disabled="@_salonIsActive" />
                        <ValidationMessage For="() => _model.Host" class="field-error" />
                    </div>

                    <div class="form-row-2">
                        <div class="form-group">
                            <label class="form-label">Port <span class="required">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Port"
                                         disabled="@_salonIsActive" />
                            <ValidationMessage For="() => _model.Port" class="field-error" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Callsign <span class="required">*</span></label>
                        <InputText class="form-control" @bind-Value="_model.Callsign"
                                   disabled="@_salonIsActive" />
                        <ValidationMessage For="() => _model.Callsign" class="field-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Clé d'authentification <span class="required">*</span></label>
                        <InputText class="form-control" @bind-Value="_model.AuthKey"
                                   type="password" disabled="@_salonIsActive" />
                        <ValidationMessage For="() => _model.AuthKey" class="field-error" />
                    </div>
                </div>

                <!-- Section avancée SVXLink (collapsible) -->
                <div class="card card-advanced">
                    <button type="button" class="advanced-toggle" @onclick="() => _showAdvanced = !_showAdvanced">
                        <span class="material-symbols-outlined">settings</span>
                        <span>Configuration SVXLink avancée</span>
                        <span class="material-symbols-outlined advanced-chevron @(_showAdvanced ? "open" : "")">
                            keyboard_arrow_down
                        </span>
                    </button>

                    @if (!_showAdvanced)
                    {
                        <p class="advanced-hint">
                            Cliquez pour afficher les paramètres avancés (identifiants, logs, timeouts).
                        </p>
                    }
                    else
                    {
                        <div class="advanced-body">
                            <div class="form-group">
                                <label class="form-label">Callsign Simplex</label>
                                <InputText class="form-control" @bind-Value="_model.SimplexCallsign"
                                           disabled="@_salonIsActive" />
                            </div>

                            <div class="form-row-2">
                                <div class="form-group">
                                    <label class="form-label">Intervalle ident. court (s)</label>
                                    <InputNumber class="form-control" @bind-Value="_model.ShortIdentInterval"
                                                 disabled="@_salonIsActive" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Intervalle ident. long (s)</label>
                                    <InputNumber class="form-control" @bind-Value="_model.LongIdentInterval"
                                                 disabled="@_salonIsActive" />
                                </div>
                            </div>

                            <div class="form-row-2">
                                <div class="form-group">
                                    <label class="form-label">Délai son de roger (ms)</label>
                                    <InputNumber class="form-control" @bind-Value="_model.RgrSoundDelay"
                                                 disabled="@_salonIsActive" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Langue par défaut</label>
                                    <select class="form-select" @bind="_model.DefaultLang"
                                            disabled="@_salonIsActive">
                                        <option value="fr_FR">fr_FR</option>
                                        <option value="en_US">en_US</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Erreurs globales ──────────────────────────────── -->
        @if (_errors.Any())
        {
            <div class="global-errors">
                @foreach (var err in _errors)
                {
                    <div class="global-error-item">
                        <span class="material-symbols-outlined">error</span>
                        @err
                    </div>
                }
            </div>
        }

        <!-- ── Actions ──────────────────────────────────────── -->
        <div class="form-actions">
            <a href="/salons" class="btn btn-secondary">
                <span class="material-symbols-outlined">close</span>
                Annuler
            </a>
            <button type="submit" class="btn btn-primary"
                    disabled="@(_isSubmitting || _salonIsActive)">
                @if (_isSubmitting)
                {
                    <span class="material-symbols-outlined spin">progress_activity</span>
                }
                else
                {
                    <span class="material-symbols-outlined">save</span>
                }
                Enregistrer
            </button>
        </div>

    </EditForm>
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        color: var(--text-muted);
        transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }
    .back-link .material-symbols-outlined { font-size: 16px; }

    .form-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 24px;
    }
    @@media (max-width: 900px) { .form-layout { grid-template-columns: 1fr; } }

    .form-col { display: flex; flex-direction: column; }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .required { color: var(--danger); margin-left: 2px; }

    .field-hint { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

    .field-error {
        display: block;
        font-size: 12px;
        color: var(--danger);
        margin-top: 4px;
    }

    /* ── Bandeau actif ─────────────────────────────────────── */
    .alert-active {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: rgba(253,203,110,0.12);
        border: 1px solid rgba(253,203,110,0.4);
        border-radius: var(--radius-sm);
        padding: 14px 16px;
        margin-bottom: 18px;
        color: var(--warning);
    }

    .alert-active .material-symbols-outlined { font-size: 22px; flex-shrink: 0; margin-top: 1px; }

    .alert-active div { display: flex; flex-direction: column; gap: 3px; }

    .alert-active strong { font-size: 14px; font-weight: 600; }

    .alert-active span { font-size: 13px; opacity: 0.85; }

    /* ── Barre d'infos immuables ──────────────────────────── */
    .info-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
        padding: 12px 16px;
        background: rgba(108,92,231,0.06);
        border-color: rgba(108,92,231,0.2);
    }

    .info-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 15px;
        font-weight: 600;
        color: var(--text);
    }

    .info-chip .material-symbols-outlined { font-size: 18px; color: var(--accent); }

    .info-chip-note {
        margin-left: auto;
        font-size: 12px;
        color: var(--text-muted);
        font-style: italic;
    }

    /* ── Section avancée ───────────────────────────────────── */
    .card-advanced { padding-top: 16px; }

    .advanced-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        background: none;
        border: none;
        color: var(--text);
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
        text-align: left;
    }

    .advanced-toggle .material-symbols-outlined { font-size: 20px; color: var(--accent); }

    .advanced-chevron {
        margin-left: auto;
        font-size: 20px !important;
        color: var(--text-muted) !important;
        transition: transform 0.2s;
    }
    .advanced-chevron.open { transform: rotate(180deg); }

    .advanced-hint {
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 10px;
        padding: 12px;
        background: rgba(108,92,231,0.06);
        border-radius: var(--radius-sm);
        border-left: 3px solid var(--accent);
    }

    .advanced-body { margin-top: 18px; }

    /* ── Squelette ─────────────────────────────────────────── */
    .skeleton-card { padding: 0; overflow: hidden; }

    /* ── Not found ─────────────────────────────────────────── */
    .not-found-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        padding: 60px 20px;
        color: var(--text-muted);
        text-align: center;
    }
    .not-found-box .material-symbols-outlined { font-size: 48px; }
    .not-found-box p { font-size: 16px; }

    /* ── Erreurs globales ───────────────────────────────────── */
    .global-errors {
        background: rgba(255,107,107,0.08);
        border: 1px solid rgba(255,107,107,0.3);
        border-radius: var(--radius-sm);
        padding: 14px 16px;
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .global-error-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--danger);
    }

    .global-error-item .material-symbols-outlined { font-size: 16px; }

    /* ── Actions ────────────────────────────────────────────── */
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .spin { animation: spin 1s linear infinite; }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .sound-info .form-group { margin-bottom: 6px; }
    .sound-info .form-value { color: var(--text-secondary, #555); }

    /* ── Son d'annonce — drag-and-drop ──────────────────────── */
    .format-hint {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-muted);
        background: rgba(108,92,231,0.06);
        border: 1px solid rgba(108,92,231,0.18);
        border-radius: var(--radius-sm);
        padding: 8px 12px;
        margin-bottom: 12px;
    }
    .format-hint .material-symbols-outlined { font-size: 15px; color: var(--accent); }
    .format-hint strong { color: var(--text); }

    .drop-zone {
        position: relative;
        border: 2px dashed var(--border-card);
        border-radius: var(--radius-sm);
        padding: 28px 20px;
        text-align: center;
        transition: border-color 0.15s, background 0.15s;
        cursor: pointer;
    }
    .drop-zone--over, .drop-zone:hover {
        border-color: var(--accent);
        background: rgba(108,92,231,0.06);
    }
    .drop-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
        z-index: 2;
    }
    .drop-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        pointer-events: none;
    }
    .drop-icon { font-size: 40px; color: var(--text-muted); }
    .drop-text { font-size: 14px; color: var(--text-muted); }
    .drop-text strong { color: var(--accent); }
    .drop-text--selected {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--success);
        font-weight: 500;
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private SalonAggregate? _salon;
    private bool _salonIsActive;
    private SoundSummaryDto? _soundSummary;
    private string _soundName = "";
    private IBrowserFile? _soundFile;
    private string _soundFileName = "";
    private bool _isDragOver;
    private Dictionary<decimal, string> _ctcssOptions = [];
    private readonly EditModel _model = new();
    private bool _isLoading = true;
    private bool _notFound;
    private bool _showAdvanced;
    private bool _isSubmitting;
    private List<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        _ctcssOptions = CtcssDropdownService.GetCtcssOptions();

        var salonResult = await Mediator.Send<Validation<Error, SalonAggregate>>(new GetSalonByIdQuery(Id));

        salonResult.Match(
            Succ: salon =>
            {
                _salon = salon;
                _salonIsActive = Tracker.IsSalonActive(salon.Id);
                PopulateModel(salon);
                return Unit.Default;
            },
            Fail: _ =>
            {
                _notFound = true;
                return Unit.Default;
            }
        );

        if (_salon?.SoundId != null)
        {
            _soundSummary = await Mediator.Send(new GetSalonSoundQuery(_salon.Id));
        }

        _isLoading = false;
    }

    private void PopulateModel(SalonAggregate salon)
    {
        var cfg = salon.Configuration;

        _model.RxFrequency        = salon.Configuration.RxFrequency;
        _model.TxFrequency        = salon.Configuration.TxFrequency;
        _model.RxCtcssStr         = cfg.RxCtcss?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _model.TxCtcssStr         = cfg.TxCtcss?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _model.Host               = cfg.Host;
        _model.Port               = cfg.Port;
        _model.Callsign           = cfg.Callsign;
        _model.AuthKey            = cfg.AuthKey;
        _model.SimplexCallsign    = cfg.SimplexCallsign;
        _model.ShortIdentInterval = cfg.ShortIdentInterval;
        _model.LongIdentInterval  = cfg.LongIdentInterval;
        _model.RgrSoundDelay      = cfg.RgrSoundDelay;
        _model.DefaultLang        = cfg.DefaultLang;
        _model.DtmfCode           = salon.DtmfCode;
    }

    private async Task HandleSubmit()
    {
        if (_salon is null || _salonIsActive) return;

        _errors.Clear();
        _isSubmitting = true;

        try
        {
            var existingCfg = _salon.Configuration;

            var newConfig = new SvxLinkConfiguration(
                Id:                  existingCfg.Id,
                Logics:              existingCfg.Logics,
                CfgDir:              existingCfg.CfgDir,
                CardSampleRate:      existingCfg.CardSampleRate,
                CardChannels:        existingCfg.CardChannels,
                Host:                _model.Host.Trim(),
                Port:                _model.Port,
                Callsign:            _model.Callsign.Trim().ToUpperInvariant(),
                AuthKey:             _model.AuthKey,
                JitterBufferDelay:   existingCfg.JitterBufferDelay,
                SimplexCallsign:     string.IsNullOrWhiteSpace(_model.SimplexCallsign)
                                         ? _model.Callsign.Trim().ToUpperInvariant()
                                         : _model.SimplexCallsign.Trim().ToUpperInvariant(),
                Modules:             existingCfg.Modules,
                ShortIdentInterval:  _model.ShortIdentInterval,
                LongIdentInterval:   _model.LongIdentInterval,
                ReportCtcss:         existingCfg.ReportCtcss,
                DefaultLang:         _model.DefaultLang,
                RgrSoundDelay:       _model.RgrSoundDelay,
                RxFrequency:         _model.RxFrequency,
                TxFrequency:         _model.TxFrequency,
                RxCtcss:             ParseCtcss(_model.RxCtcssStr),
                TxCtcss:             ParseCtcss(_model.TxCtcssStr)
            );

            var command = new UpdateSalonConfigurationCommand(
                Id:           Id,
                RxFrequency:  _model.RxFrequency,
                TxFrequency:  _model.TxFrequency,
                RxCtcss:      ParseCtcss(_model.RxCtcssStr),
                TxCtcss:      ParseCtcss(_model.TxCtcssStr),
                Configuration: newConfig
            );

            var result = await Mediator.Send<Validation<Error, Unit>>(command);

            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess($"Salon « {_salon.Name} » mis à jour.");
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    _errors = errors.Select(e => e.Message).ToList();
                    return Unit.Default;
                }
            );

            // Mise à jour du code DTMF si la configuration a été sauvegardée avec succès
            if (!_errors.Any() && _model.DtmfCode != _salon.DtmfCode)
            {
                var dtmfResult = await Mediator.Send<Validation<Error, Unit>>(
                    new UpdateSalonDtmfCodeCommand(Id, _model.DtmfCode));

                dtmfResult.Match(
                    Succ: _ => Unit.Default,
                    Fail: errors =>
                    {
                        _errors = errors.Select(e => e.Message).ToList();
                        return Unit.Default;
                    }
                );
            }

            if (!_errors.Any())
                Nav.NavigateTo("/salons");
        }
        catch (Exception ex)
        {
            _errors = [$"Erreur inattendue : {ex.Message}"];
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static decimal? ParseCtcss(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null;
        return decimal.TryParse(value, System.Globalization.NumberStyles.Number,
                                System.Globalization.CultureInfo.InvariantCulture, out var d)
               ? d : null;
    }

    private void OnSoundFileSelected(InputFileChangeEventArgs e)
    {
        _soundFile = e.File;
        _soundFileName = e.File.Name;
        if (string.IsNullOrWhiteSpace(_soundName))
            _soundName = Path.GetFileNameWithoutExtension(e.File.Name);
        _isDragOver = false;
    }

    private async Task HandleUploadSelectedFile()
    {
        if (_soundFile is null || string.IsNullOrWhiteSpace(_soundName)) return;

        try
        {
            using var ms = new MemoryStream();
            await _soundFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

            var result = await Mediator.Send(new UploadSalonSoundCommand(Id, _soundName.Trim(), ms.ToArray()));
            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Son ajouté avec succès.");
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    _errors = errors.Select(e => e.Message).ToList();
                    return Unit.Default;
                });

            if (!_errors.Any())
            {
                _soundSummary = await Mediator.Send(new GetSalonSoundQuery(Id));
                _soundFile = null;
                _soundFileName = "";
                _soundName = "";
            }
        }
        catch (Exception ex)
        {
            _errors = [$"Erreur lors de l'upload : {ex.Message}"];
        }
    }

    private async Task HandleSoundReplace(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var name = Path.GetFileNameWithoutExtension(file.Name);
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);

            var result = await Mediator.Send(new ReplaceSalonSoundCommand(Id, name, ms.ToArray()));
            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Son remplacé avec succès.");
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    _errors = errors.Select(e => e.Message).ToList();
                    return Unit.Default;
                });

            if (!_errors.Any())
                _soundSummary = await Mediator.Send(new GetSalonSoundQuery(Id));
        }
        catch (Exception ex)
        {
            _errors = [$"Erreur lors du remplacement : {ex.Message}"];
        }
    }

    private async Task HandleSoundDelete()
    {
        try
        {
            var result = await Mediator.Send(new DeleteSalonSoundCommand(Id));
            result.Match(
                Succ: _ =>
                {
                    _soundSummary = null;
                    ToastService.ShowSuccess("Son supprimé avec succès.");
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    _errors = errors.Select(e => e.Message).ToList();
                    return Unit.Default;
                });
        }
        catch (Exception ex)
        {
            _errors = [$"Erreur lors de la suppression : {ex.Message}"];
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes >= 1)
            return $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s";
        return $"{duration.Seconds}s";
    }

    // ── Modèle de formulaire ──────────────────────────────────
    private class EditModel
    {
        [System.ComponentModel.DataAnnotations.Range(30, 3000, ErrorMessage = "La fréquence doit être entre 30 et 3000 MHz.")]
        public decimal RxFrequency { get; set; }

        [System.ComponentModel.DataAnnotations.Range(30, 3000, ErrorMessage = "La fréquence doit être entre 30 et 3000 MHz.")]
        public decimal TxFrequency { get; set; }

        public string RxCtcssStr { get; set; } = "";
        public string TxCtcssStr { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "L'hôte est obligatoire.")]
        public string Host { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Range(1, 65535, ErrorMessage = "Le port doit être entre 1 et 65535.")]
        public int Port { get; set; } = 5300;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le callsign est obligatoire.")]
        public string Callsign { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La clé d'authentification est obligatoire.")]
        public string AuthKey { get; set; } = "";

        public string SimplexCallsign { get; set; } = "";
        public int ShortIdentInterval { get; set; } = 6;
        public int LongIdentInterval { get; set; } = 60;
        public int RgrSoundDelay { get; set; } = 0;
        public string DefaultLang { get; set; } = "fr_FR";

        [System.ComponentModel.DataAnnotations.Range(1, 9999, ErrorMessage = "Le code DTMF doit être entre 1 et 9999.")]
        public int? DtmfCode { get; set; }
    }
