        public int Port { get; set; } = 5300;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le callsign est obligatoire.")]
        public string Callsign { get; set; } = "";

        public string AuthKey { get; set; } = "";

        public ReflectorProtocol ReflectorProtocol { get; set; } = ReflectorProtocol.V2;

        public string CertEmail { get; set; } = "";
        
        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue, ErrorMessage = "Le TG par défaut doit être supérieur ou égal à 0.")]
