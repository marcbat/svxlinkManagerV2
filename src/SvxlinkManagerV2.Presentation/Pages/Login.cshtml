@page "/login"
@model SvxlinkManagerV2.Presentation.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — SvxLink Manager V2</title>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-primary, #1a1d23);
        }
        .login-card {
            background: var(--bg-secondary, #242830);
            border-radius: 12px;
            padding: 2rem;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }
        .login-logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            color: var(--accent, #4f8ef7);
            font-size: 1.2rem;
            font-weight: 600;
        }
        .login-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text-primary, #e2e8f0);
            margin-bottom: 0.25rem;
        }
        .login-subtitle {
            color: var(--text-muted, #8892a4);
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
        }
        .form-group { margin-bottom: 1rem; }
        .form-label {
            display: block;
            font-size: 0.875rem;
            color: var(--text-secondary, #a0aec0);
            margin-bottom: 0.4rem;
        }
        .form-control {
            width: 100%;
            padding: 0.6rem 0.8rem;
            background: var(--bg-input, #1a1d23);
            border: 1px solid var(--border, #353a45);
            border-radius: 6px;
            color: var(--text-primary, #e2e8f0);
            font-size: 0.9rem;
            box-sizing: border-box;
        }
        .form-control:focus {
            outline: none;
            border-color: var(--accent, #4f8ef7);
        }
        .form-check { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
        .form-check-label { font-size: 0.875rem; color: var(--text-secondary, #a0aec0); }
        .btn-primary {
            width: 100%;
            padding: 0.7rem;
            background: var(--accent, #4f8ef7);
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
        }
        .btn-primary:hover { background: #3a7ae0; }
        .alert-danger {
            background: rgba(239,68,68,0.15);
            border: 1px solid rgba(239,68,68,0.4);
            border-radius: 6px;
            padding: 0.75rem;
            color: #f87171;
            font-size: 0.875rem;
            margin-bottom: 1rem;
        }
        .alert-info {
            background: rgba(79,142,247,0.15);
            border: 1px solid rgba(79,142,247,0.4);
            border-radius: 6px;
            padding: 0.75rem;
            color: #93c5fd;
            font-size: 0.875rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-logo">
                <span class="material-symbols-outlined">settings_input_antenna</span>
                <span>SvxLink Manager V2</span>
            </div>
            <h1 class="login-title">Connexion</h1>
            <p class="login-subtitle">Entrez vos identifiants pour accéder à l'application.</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-danger">@Model.ErrorMessage</div>
            }

            @if (!Model.HasAnyUser)
            {
                <div class="alert-info">
                    Aucun compte n'a été configuré.
                    <a href="/setup">Créez d'abord un compte</a> via l'assistant de configuration.
                </div>
            }
            else
            {
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <div class="form-group">
                        <label class="form-label" for="username">Nom d'utilisateur</label>
                        <input type="text" id="username" name="username" class="form-control"
                               autocomplete="username" autofocus required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="password">Mot de passe</label>
                        <input type="password" id="password" name="password" class="form-control"
                               autocomplete="current-password" required />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="rememberMe" name="rememberMe" class="form-check-input" value="true" />
                        <label class="form-check-label" for="rememberMe">Se souvenir de moi</label>
                    </div>
                    <button type="submit" class="btn-primary">Se connecter</button>
                </form>
            }
        </div>
    </div>
</body>
</html>
