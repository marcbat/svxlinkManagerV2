@page "/account/password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SvxlinkManagerV2.Application.Interfaces

@inject IUserAccountService UserAccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ToastService ToastService

<div class="page-header">
    <h1 class="page-title">Changer le mot de passe</h1>
</div>

<div class="card">
    <div class="card-body">
        @if (_errorMessages.Any())
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in _errorMessages)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="form-group">
            <label class="form-label" for="currentPassword">Mot de passe actuel</label>
            <input type="password" id="currentPassword" class="form-control"
                   @bind="_currentPassword"
                   autocomplete="current-password" />
        </div>

        <div class="form-group">
            <label class="form-label" for="newPassword">Nouveau mot de passe</label>
            <input type="password" id="newPassword" class="form-control"
                   @bind="_newPassword"
                   autocomplete="new-password" />
            <small class="form-text text-muted">Minimum 8 caractères.</small>
        </div>

        <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirmer le nouveau mot de passe</label>
            <input type="password" id="confirmPassword" class="form-control"
                   @bind="_confirmPassword"
                   autocomplete="new-password" />
        </div>

        <button class="btn btn-primary"
                @onclick="SubmitPasswordChange"
                disabled="@(_isLoading || !IsValid)">
            @if (_isLoading)
            {
                <span class="material-symbols-outlined spinning">sync</span>
                <span>Modification...</span>
            }
            else
            {
                <span class="material-symbols-outlined">save</span>
                <span>Modifier le mot de passe</span>
            }
        </button>
    </div>
</div>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading;
    private List<string> _errorMessages = new();
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_currentPassword) &&
        !string.IsNullOrWhiteSpace(_newPassword) &&
        _newPassword.Length >= 8 &&
        _newPassword == _confirmPassword;

    private async Task SubmitPasswordChange()
    {
        _errorMessages.Clear();

        if (_userId is null)
        {
            _errorMessages.Add("Utilisateur non identifié. Veuillez vous reconnecter.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _errorMessages.Add("Le mot de passe actuel est obligatoire.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 8)
        {
            _errorMessages.Add("Le nouveau mot de passe doit contenir au moins 8 caractères.");
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessages.Add("Les mots de passe ne correspondent pas.");
            return;
        }

        _isLoading = true;

        try
        {
            var result = await UserAccountService.ChangePasswordAsync(_userId, _currentPassword, _newPassword);

            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Mot de passe modifié avec succès.");
                    _currentPassword = string.Empty;
                    _newPassword = string.Empty;
                    _confirmPassword = string.Empty;
                    _isLoading = false;
                    StateHasChanged();
                },
                Fail: errors =>
                {
                    _errorMessages = errors
                        .Select(e => e.Message.Contains("USER_WRONG_CURRENT_PASSWORD")
                            ? "Mot de passe actuel incorrect."
                            : e.Message.Replace("USER_PASSWORD_CHANGE_FAILED: ", ""))
                        .ToList();
                    _isLoading = false;
                }
            );
        }
        catch (Exception)
        {
            _errorMessages.Add("Une erreur inattendue s'est produite. Veuillez réessayer.");
            _isLoading = false;
        }
    }
}
