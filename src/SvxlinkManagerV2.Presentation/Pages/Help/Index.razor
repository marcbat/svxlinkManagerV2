@page "/aide"
@using SvxlinkManagerV2.Application.Features.Salons.GetAllSalons
@using SvxlinkManagerV2.Domain.Aggregates.Salon

@inject IMediator Mediator

<!-- ── Page Header ─────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <h1 class="page-title">Aide</h1>
        <p class="page-subtitle">Commandes DTMF disponibles sur ce nœud.</p>
    </div>
</div>

<!-- ── Raccourcis DTMF - Sélection de salon ─────────────────── -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="section-header">
        <span class="material-symbols-outlined">dialpad</span>
        Sélection de salon par DTMF
    </div>

    @if (_isLoading)
    {
        <div class="skeleton" style="height: 120px; border-radius: 8px;"></div>
    }
    else if (_salonsWithDtmf.Count == 0)
    {
        <p style="color: var(--text-muted); margin: 0.5rem 0 0;">
            Aucun salon n'a de code DTMF configuré pour le moment.
        </p>
    }
    else
    {
        <table class="help-dtmf-table">
            <thead>
                <tr>
                    <th>Code DTMF</th>
                    <th>Salon</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var salon in _salonsWithDtmf)
                {
                    <tr>
                        <td>
                            <span class="badge badge-accent">
                                <span class="material-symbols-outlined">dialpad</span>
                                @salon.DtmfCode
                            </span>
                        </td>
                        <td>@salon.Name</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="help-dtmf-hint">
            <span class="material-symbols-outlined">info</span>
            Composez le code DTMF depuis le transceiver pour basculer automatiquement vers le salon correspondant.
        </p>
    }
</div>

<!-- ── Commandes d'annonce vocale ───────────────────────────── -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="section-header">
        <span class="material-symbols-outlined">campaign</span>
        Commandes d'annonce vocale (300-399)
    </div>

    <table class="help-dtmf-table">
        <thead>
            <tr>
                <th>Code DTMF</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <span class="badge badge-accent">
                        <span class="material-symbols-outlined">dialpad</span>
                        300
                    </span>
                </td>
                <td>Rejouer le nom du salon actif (indicatif, nom, fréquence TX si split)</td>
            </tr>
            <tr>
                <td>
                    <span class="badge badge-accent">
                        <span class="material-symbols-outlined">dialpad</span>
                        301
                    </span>
                </td>
                <td>Annoncer la température du processeur</td>
            </tr>
        </tbody>
    </table>
    <p class="help-dtmf-hint">
        <span class="material-symbols-outlined">info</span>
        Ces commandes déclenchent une annonce vocale sur la fréquence sans changer le salon actif.
    </p>
</div>

<!-- ── Commandes système ────────────────────────────────────── -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="section-header">
        <span class="material-symbols-outlined">settings_remote</span>
        Commandes système
    </div>

    <table class="help-dtmf-table">
        <thead>
            <tr>
                <th>Code DTMF</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var command in DtmfSystemCommands.All)
            {
                <tr>
                    <td>
                        <span class="badge badge-accent">
                            <span class="material-symbols-outlined">dialpad</span>
                            @command.Code
                        </span>
                    </td>
                    <td>@command.Description</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="help-dtmf-hint">
        <span class="material-symbols-outlined">info</span>
        Ces commandes pilotent le nœud depuis le transceiver, sans passer par l'interface web.
        Chacune est confirmée par une annonce vocale.
    </p>
</div>

<!-- ── Modules SVXLink ──────────────────────────────────────── -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="section-header">
        <span class="material-symbols-outlined">extension</span>
        Modules SVXLink (1-19)
    </div>

    <table class="help-dtmf-table">
        <thead>
            <tr>
                <th>Code DTMF</th>
                <th>Module</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <span class="badge badge-accent">
                        <span class="material-symbols-outlined">dialpad</span>
                        1
                    </span>
                </td>
                <td>Help — Aide vocale SVXLink</td>
            </tr>
            <tr>
                <td>
                    <span class="badge badge-accent">
                        <span class="material-symbols-outlined">dialpad</span>
                        2
                    </span>
                </td>
                <td>Parrot — Répéteur perroquet (enregistre puis rejoue l'audio)</td>
            </tr>
        </tbody>
    </table>
    <p class="help-dtmf-hint">
        <span class="material-symbols-outlined">info</span>
        Les codes 1-19 activent directement un module SVXLink. Pour quitter un module actif, envoyez <strong>#</strong>.
    </p>
</div>

<!-- ── Plages DTMF — Référence technique ───────────────────── -->
<div class="card" style="margin-bottom: 1.5rem;">
    <div class="section-header">
        <span class="material-symbols-outlined">developer_guide</span>
        Plages DTMF — Référence technique
    </div>

    <table class="help-dtmf-table">
        <thead>
            <tr>
                <th>Plage</th>
                <th>Usage</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span class="badge badge-accent">1 — 19</span></td>
                <td>Modules SVXLink (Parrot, Help, etc.) — traités directement par SVXLink</td>
            </tr>
            <tr>
                <td><span class="badge badge-accent">20 — 299</span></td>
                <td>Codes salon — changement de salon par radio</td>
            </tr>
            <tr>
                <td><span class="badge badge-accent">300 — 399</span></td>
                <td>Commandes d'annonce vocale, commandes système et commandes internes</td>
            </tr>
            <tr>
                <td><span class="badge badge-accent">400 — 9999</span></td>
                <td>Codes salon — changement de salon par radio (plage étendue)</td>
            </tr>
        </tbody>
    </table>
    <p class="help-dtmf-hint">
        <span class="material-symbols-outlined">info</span>
        Lors de l'attribution d'un code DTMF à un salon, seules les plages <strong>20-299</strong> et <strong>400-9999</strong> sont disponibles.
        Les plages 1-19 et 300-399 sont réservées au système.
    </p>
</div>

@code {
    private bool _isLoading = true;
    private List<SalonAggregate> _salonsWithDtmf = [];

    protected override async Task OnInitializedAsync()
    {
        var salons = await Mediator.Send(new GetAllSalonsQuery());
        _salonsWithDtmf = salons
            .Where(s => s.DtmfCode.HasValue)
            .OrderBy(s => s.DtmfCode)
            .ToList();
        _isLoading = false;
    }
}
