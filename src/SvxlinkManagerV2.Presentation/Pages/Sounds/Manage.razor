@page "/sounds"
@using SvxlinkManagerV2.Application.Features.Sounds.GetAllSounds
@using SvxlinkManagerV2.Application.Features.Sounds.DeleteSound
@using SvxlinkManagerV2.Domain.Aggregates.Sound
@using SvxlinkManagerV2.Presentation.Services
@using SvxlinkManagerV2.Presentation.Shared
@using Wolverine
@inject IMessageBus Bus
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject AudioService AudioService

<PageTitle>Gestion des Sons</PageTitle>

<div class="container">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="bi bi-music-note-list me-2"></i>
                    Bibliothèque Audio
                </h3>
                <button type="button" class="btn btn-success" @onclick="NavigateToUpload">
                    <i class="bi bi-upload me-2"></i>
                    Uploader un nouveau son
                </button>
            </div>
        </div>

        <div class="card-body">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="text-muted mt-2">Chargement de la bibliothèque audio...</p>
                </div>
            }
            else if (!_filteredSounds.Any())
            {
                @if (!_sounds.Any())
                {
                    <div class="alert alert-info text-center py-4" role="alert">
                        <i class="bi bi-info-circle fs-1 mb-3"></i>
                        <h5>Aucun fichier audio</h5>
                        <p class="mb-3">Vous n'avez pas encore uploadé de fichiers audio pour vos annonces vocales.</p>
                        <button type="button" class="btn btn-success" @onclick="NavigateToUpload">
                            <i class="bi bi-upload me-2"></i>
                            Uploader votre premier son
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center" role="alert">
                        <i class="bi bi-search me-2"></i>
                        Aucun son ne correspond à votre recherche "@_searchQuery"
                    </div>
                }
            }
            else
            {
                <!-- Filtre de recherche -->
                <div class="input-group mb-3">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input 
                        type="text" 
                        class="form-control" 
                        placeholder="Rechercher un son par nom..."
                        @bind="_searchQuery"
                        @bind:event="oninput"
                        @onkeyup="FilterSounds" />
                    @if (!string.IsNullOrEmpty(_searchQuery))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    }
                </div>

                <!-- Tableau des sons -->
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th style="width: 50px;"></th>
                                <th>Nom</th>
                                <th style="width: 100px;">Durée</th>
                                <th style="width: 120px;">Sample Rate</th>
                                <th style="width: 120px;">Canaux</th>
                                <th style="width: 150px;">Date création</th>
                                <th style="width: 150px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sound in _filteredSounds)
                            {
                                <tr>
                                    <!-- Icône -->
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-circle p-2">
                                            <i class="bi bi-music-note-beamed"></i>
                                        </span>
                                    </td>

                                    <!-- Nom -->
                                    <td>
                                        <span class="fw-bold">@sound.Name</span>
                                        <br />
                                        <small class="text-muted">
                                            <i class="bi bi-file-earmark-music me-1"></i>
                                            @AudioService.FormatFileSize(sound.FileContent.Length)
                                        </small>
                                    </td>

                                    <!-- Durée -->
                                    <td>
                                        <i class="bi bi-clock me-1 text-muted"></i>
                                        @AudioService.FormatDuration(sound.Duration)
                                    </td>

                                    <!-- Sample Rate -->
                                    <td>
                                        <span class="badge bg-secondary">
                                            @AudioService.FormatSampleRate(sound.SampleRate)
                                        </span>
                                    </td>

                                    <!-- Canaux -->
                                    <td>
                                        <i class="bi bi-@(sound.Channels == 1 ? "speaker" : "soundwave") me-1"></i>
                                        @AudioService.FormatChannels(sound.Channels)
                                    </td>

                                    <!-- Date création -->
                                    <td>
                                        <small class="text-muted">
                                            @AudioService.GetRelativeTime(sound.CreatedAt)
                                        </small>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button 
                                                type="button" 
                                                class="btn btn-primary" 
                                                @onclick="() => TogglePlayer(sound.Id)"
                                                title="@(_expandedSoundId == sound.Id ? "Masquer le player" : "Lire le son")">
                                                <i class="bi bi-@(_expandedSoundId == sound.Id ? "stop-fill" : "play-fill")"></i>
                                            </button>
                                            <button 
                                                type="button" 
                                                class="btn btn-danger" 
                                                @onclick="() => ShowDeleteConfirmation(sound)"
                                                title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                @if (_expandedSoundId == sound.Id)
                                {
                                    <tr>
                                        <td colspan="7" class="p-0">
                                            <AudioPlayer 
                                                AudioDataUri="@GetAudioDataUri(sound)" 
                                                IsExpanded="true" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Informations -->
                <div class="text-muted small mt-3">
                    <i class="bi bi-info-circle me-1"></i>
                    @_filteredSounds.Count son@(_filteredSounds.Count > 1 ? "s" : "") affiché@(_filteredSounds.Count > 1 ? "s" : "")
                    @if (_sounds.Count != _filteredSounds.Count)
                    {
                        <span> sur @_sounds.Count au total</span>
                    }
                </div>
            }

            <ErrorDisplay ValidationResult="@_validationResult" />
        </div>
    </div>
</div>

<!-- Modal de confirmation de suppression -->
<ConfirmModal 
    @ref="_confirmModal"
    Title="Confirmer la suppression"
    Type="ConfirmModalType.Danger"
    Icon="exclamation-triangle"
    ConfirmButtonText="Supprimer"
    ConfirmIcon="trash"
    CancelButtonText="Annuler"
    OnConfirm="DeleteSound">
    <Message>
        @if (_soundToDelete != null)
        {
            <p>Êtes-vous sûr de vouloir supprimer le son <strong>@_soundToDelete.Name</strong> ?</p>
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Cette action est irréversible.
            </div>
        }
    </Message>
</ConfirmModal>

@code {
    private List<SoundAggregate> _sounds = new();
    private List<SoundAggregate> _filteredSounds = new();
    private bool _isLoading = true;
    private object? _validationResult;
    private string _searchQuery = string.Empty;
    private Guid? _expandedSoundId;
    private Dictionary<Guid, string> _audioDataUriCache = new();

    private ConfirmModal? _confirmModal;
    private SoundAggregate? _soundToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadSounds();
    }

    private async Task LoadSounds()
    {
        _isLoading = true;
        _validationResult = null;

        try
        {
            var query = new GetAllSoundsQuery();
            var sounds = await Bus.InvokeAsync<IReadOnlyList<SoundAggregate>>(query);

            _sounds = sounds.Where(s => !s.IsDeleted).ToList();
            _filteredSounds = _sounds;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur lors du chargement des sons : {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterSounds()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _filteredSounds = _sounds;
        }
        else
        {
            var query = _searchQuery.ToLowerInvariant();
            _filteredSounds = _sounds
                .Where(s => s.Name.ToLowerInvariant().Contains(query))
                .ToList();
        }
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        FilterSounds();
    }

    private void TogglePlayer(Guid soundId)
    {
        if (_expandedSoundId == soundId)
        {
            // Fermer le player
            _expandedSoundId = null;
        }
        else
        {
            // Ouvrir le player pour ce son
            _expandedSoundId = soundId;
        }
    }

    private string GetAudioDataUri(SoundAggregate sound)
    {
        // Utiliser le cache pour éviter de recalculer le data URI à chaque render
        if (!_audioDataUriCache.ContainsKey(sound.Id))
        {
            _audioDataUriCache[sound.Id] = AudioService.ConvertToDataUri(sound.FileContent);
        }
        return _audioDataUriCache[sound.Id];
    }

    private void ShowDeleteConfirmation(SoundAggregate sound)
    {
        _soundToDelete = sound;
        _confirmModal?.Show();
    }

    private async Task DeleteSound()
    {
        if (_soundToDelete == null)
            return;

        try
        {
            var command = new DeleteSoundCommand(_soundToDelete.Id);
            var result = await Bus.InvokeAsync<LanguageExt.Validation<LanguageExt.Common.Error, LanguageExt.Unit>>(command);

            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess($"Le son '{_soundToDelete.Name}' a été supprimé avec succès.");
                    
                    // Retirer le son de la liste
                    _sounds.Remove(_soundToDelete);
                    FilterSounds();
                    
                    // Retirer du cache
                    _audioDataUriCache.Remove(_soundToDelete.Id);
                    
                    // Fermer le player si ce son était en lecture
                    if (_expandedSoundId == _soundToDelete.Id)
                    {
                        _expandedSoundId = null;
                    }
                    
                    _soundToDelete = null;
                    StateHasChanged();
                    return LanguageExt.Unit.Default;
                },
                Fail: errors =>
                {
                    _validationResult = result;
                    ToastService.ShowError("Erreur lors de la suppression du son.");
                    return LanguageExt.Unit.Default;
                });
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur lors de la suppression : {ex.Message}");
        }
    }

    private void NavigateToUpload()
    {
        NavigationManager.NavigateTo("/sounds/upload");
    }
}
