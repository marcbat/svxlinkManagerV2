@page "/reflector"
@using SvxlinkManagerV2.Application.Features.Reflectors.ActivateReflector
@using SvxlinkManagerV2.Application.Features.Reflectors.CreateReflector
@using SvxlinkManagerV2.Application.Features.Reflectors.DeactivateReflector
@using SvxlinkManagerV2.Application.Features.Reflectors.GetAllReflectors
@using SvxlinkManagerV2.Application.Features.Reflectors.GetReflectorStatus
@using SvxlinkManagerV2.Application.Features.Reflectors.ApplyRecommendedSettings
@using SvxlinkManagerV2.Application.Features.Reflectors.UpdateReflectorConfiguration
@using SvxlinkManagerV2.Application.Interfaces
@using SvxlinkManagerV2.Domain.Aggregates.Reflector
@using SvxlinkManagerV2.Domain.Common
@using SvxlinkManagerV2.Application.Models
@using SvxlinkManagerV2.Infrastructure.Persistence

@inject IMediator Mediator
@inject IReflectorDaemonService DaemonService
@inject IReflectorStatusService StatusService
@inject ToastService ToastService
@inject IJSRuntime JS
@implements IAsyncDisposable

<!-- ── Page Header ─────────────────────────────────────────── -->
<div class="page-header">
    <div class="page-title-group">
        <h1>
            <span class="material-symbols-outlined">hub</span>
            SvxReflector
        </h1>
        @if (_isLoading)
        {
            <span class="badge badge-muted">
                <span class="loading-dot"></span>
                Chargement…
            </span>
        }
        else if (_isActive)
        {
            <span class="badge badge-success">
                <span class="material-symbols-outlined">radio_button_checked</span>
                Actif
            </span>
        }
        else
        {
            <span class="badge badge-muted">
                <span class="material-symbols-outlined">radio_button_unchecked</span>
                Arrêté
            </span>
        }
    </div>

    <div class="header-actions">
        <button class="btn @(_hasUnsavedChanges && !_isActive ? "btn-primary" : "btn-secondary")"
                @onclick="SaveConfigAsync"
                disabled="@(_isActive || _isSaving || _isLoading || !_hasUnsavedChanges)">
            @if (_isSaving)
            {
                <span class="material-symbols-outlined spin">sync</span>
            }
            else
            {
                <span class="material-symbols-outlined">save</span>
            }
            Sauvegarder
        </button>

        @if (_isActive)
        {
            <button class="btn btn-danger"
                    @onclick="StopReflectorAsync"
                    disabled="@(_isToggling || _isLoading)">
                @if (_isToggling)
                {
                    <span class="material-symbols-outlined spin">sync</span>
                }
                else
                {
                    <span class="material-symbols-outlined">stop</span>
                }
                Arrêter
            </button>
        }
        else
        {
            <button class="btn btn-success"
                    @onclick="StartReflectorAsync"
                    disabled="@(_isToggling || _isLoading || _hasUnsavedChanges)"
                    title="@(_hasUnsavedChanges ? "Sauvegardez la configuration avant de démarrer" : "")">
                @if (_isToggling)
                {
                    <span class="material-symbols-outlined spin">sync</span>
                }
                else
                {
                    <span class="material-symbols-outlined">play_arrow</span>
                }
                Démarrer
            </button>
        }
    </div>
</div>

@if (_isActive)
{
    <div class="alert-active">
        <span class="material-symbols-outlined">lock</span>
        <div>
            <strong>Reflector actuellement actif</strong>
            <span>Arrêtez le reflector avant de modifier la configuration.</span>
        </div>
    </div>
}

@if (_hasUnsavedChanges && !_isActive)
{
    <div class="alert-unsaved">
        <span class="material-symbols-outlined">edit_note</span>
        <div>
            <strong>Modifications non sauvegardées</strong>
            <span>Sauvegardez la configuration avant de démarrer le reflector.</span>
        </div>
    </div>
}

@if (_isLoading)
{
    <div class="card skeleton-card">
        <div class="skeleton" style="height:400px"></div>
    </div>
}
else
{
    <div class="card">
        <div class="section-header">
            <span class="material-symbols-outlined">monitoring</span>
            Nœuds connectés
            @if (_status.IsAvailable)
            {
                <span class="badge badge-accent" style="margin-left:8px;">@_status.Nodes.Count</span>
            }
        </div>

        @if (_status.IsAvailable && _status.Nodes.Count > 0)
        {
            <div style="overflow-x:auto;">
                <table class="help-dtmf-table">
                    <thead>
                        <tr>
                            <th>Indicatif</th>
                            <th>Talkgroup</th>
                            <th>Surveillés</th>
                            <th>Logiciel</th>
                            <th>Protocole</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var node in _status.Nodes)
                        {
                            <tr>
                                <td>
                                    <span class="material-symbols-outlined"
                                          style="font-size:16px;vertical-align:middle;@(node.IsTalker ? "color:var(--danger);" : "color:var(--text-muted);")">
                                        @(node.IsTalker ? "radio" : "radio_button_checked")
                                    </span>
                                    <strong>@node.Callsign</strong>
                                    @if (node.IsTalker)
                                    {
                                        <span class="badge badge-danger" style="margin-left:6px;">en émission</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-accent">@FormatTalkGroup(node.TalkGroup)</span>
                                    @if (node.RestrictedTalkGroup)
                                    {
                                        <span class="badge badge-muted" style="margin-left:6px;" title="Talkgroup imposé par le réflecteur">imposé</span>
                                    }
                                </td>
                                <td>@FormatMonitored(node.MonitoredTalkGroups)</td>
                                <td>@FormatSoftware(node)</td>
                                <td>@(node.ProtocolVersion?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="help-dtmf-hint">
                <span class="material-symbols-outlined">info</span>
                Deux nœuds sur des talkgroups différents ne s'entendent pas, même connectés au
                même réflecteur.
                @if (_status.RetrievedAtUtc is { } at)
                {
                    <span> Dernière lecture : @at.ToLocalTime().ToString("HH:mm:ss").</span>
                }
            </p>
        }
        else if (_status.IsAvailable)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">hub</span>
                <p>Aucun nœud connecté pour le moment.</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">monitoring</span>
                <p>
                    @(_status.Detail ?? "Statut du réflecteur en cours de lecture…")
                    @if (_status.Availability == ReflectorStatusAvailability.PortNotConfigured)
                    {
                        <br />
                        <span>
                            Ajoutez <code>HTTP_SRV_PORT=8888</code> à la section <code>[GLOBAL]</code>
                            ci-dessous, puis redémarrez le réflecteur.
                        </span>
                    }
                </p>
            </div>
        }
    </div>

    @if (_missingSettings.Count > 0)
    {
        <div class="alert-unsaved">
            <span class="material-symbols-outlined">tips_and_updates</span>
            <div>
                <strong>@_missingSettings.Count réglage(s) recommandé(s) absent(s)</strong>
                <span>
                    Cette configuration a été créée avant que ces réglages n'existent. Les
                    ajouter ne modifie ni ne supprime rien de ce qu'elle contient déjà.
                </span>
                <ul class="reflector-advice">
                    @foreach (var setting in _missingSettings)
                    {
                        <li>
                            <code>@setting.Key=@setting.Value</code>
                            <span>@setting.Rationale</span>
                        </li>
                    }
                </ul>
                <button class="btn btn-primary btn-sm" style="margin-top:8px;"
                        disabled="@(_isActive || _isApplyingSettings)"
                        @onclick="ApplyRecommendedSettingsAsync">
                    @if (_isApplyingSettings)
                    {
                        <span class="material-symbols-outlined spin">sync</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">playlist_add</span>
                    }
                    Ajouter ces réglages
                </button>
                @if (_isActive)
                {
                    <span style="margin-left:8px;">Arrêtez le réflecteur pour les ajouter.</span>
                }
            </div>
        </div>
    }

    @if (_configIssues.Count > 0)
    {
        <div class="alert-active" style="border-left-color: @(HasConfigErrors ? "var(--danger)" : "var(--warning)");">
            <span class="material-symbols-outlined">@(HasConfigErrors ? "error" : "warning")</span>
            <div>
                <strong>
                    @(HasConfigErrors
                        ? "La configuration ne peut pas être enregistrée"
                        : "Remarques sur la configuration")
                </strong>
                <span>
                    @(HasConfigErrors
                        ? "Le démon refuserait de démarrer et redémarrerait en boucle."
                        : "Rien n'empêche le démarrage, mais ces lignes sont probablement des erreurs.")
                </span>
                <ul class="reflector-advice">
                    @foreach (var issue in _configIssues)
                    {
                        <li>
                            <code>Ligne @issue.Line</code>
                            <span>@issue.Message</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="alert-info">
        <span class="material-symbols-outlined">info</span>
        <div>
            <strong>Salon pré-configuré disponible</strong>
            <span>
                Le salon <strong>Réflecteur Local</strong> est déjà configuré pour se connecter à ce réflecteur
                (<code>127.0.0.1:5300</code>). Il peut être activé directement depuis la page
                <a href="/salons">Gestion des Salons</a> sans aucune modification.
            </span>
        </div>
    </div>

    <details class="card" style="margin-bottom: 1.5rem;">
        <summary style="cursor:pointer;font-weight:600;display:flex;align-items:center;gap:8px;">
            <span class="material-symbols-outlined">help</span>
            Aide — sections de talkgroup et paramètres clés
        </summary>

        <p style="margin-top:12px;">
            Un talkgroup se déclare par une section <code>[TG#&lt;numéro&gt;]</code>. Trois
            variables la composent :
        </p>
        <table class="help-dtmf-table">
            <thead>
                <tr><th>Variable</th><th>Rôle</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>AUTO_QSY_AFTER</code></td>
                    <td>
                        Déplace vers un talkgroup tiré dans <code>RANDOM_QSY_RANGE</code> une
                        conversation qui dure plus de N secondes, pour garder libre un canal
                        d'appel. <code>0</code> désactive.
                    </td>
                </tr>
                <tr>
                    <td><code>ALLOW</code></td>
                    <td>Expression régulière des indicatifs autorisés sur ce talkgroup.</td>
                </tr>
                <tr>
                    <td><code>SHOW_ACTIVITY</code></td>
                    <td><code>0</code> masque l'activité de ce talkgroup dans le statut publié.</td>
                </tr>
            </tbody>
        </table>

        <p style="margin-top:16px;">Deux variables de <code>[GLOBAL]</code> commandent l'ensemble :</p>
        <table class="help-dtmf-table">
            <thead>
                <tr><th>Variable</th><th>Rôle</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>TG_FOR_V1_CLIENTS</code></td>
                    <td>
                        Talkgroup des nœuds en protocole V2, qui ne savent pas en sélectionner
                        un. <strong>Sans elle, ils restent muets</strong> dès qu'un talkgroup
                        est utilisé. Le talkgroup désigné doit exister.
                    </td>
                </tr>
                <tr>
                    <td><code>RANDOM_QSY_RANGE</code></td>
                    <td>
                        Plage de tirage des QSY aléatoires, syntaxe
                        <code>&lt;borne basse&gt;:&lt;nombre&gt;</code>. Convention
                        <code>&lt;MCC&gt;9900:100</code> — Suisse <code>2289900:100</code>,
                        France <code>2089900:100</code>.
                    </td>
                </tr>
            </tbody>
        </table>
    </details>

    <div class="card config-card">
        <div class="section-header">
            <span class="material-symbols-outlined">settings</span>
            Configuration (svxreflector.conf)
        </div>
        <p class="config-hint">
            Éditez directement le fichier de configuration INI du reflector.
            La section <code>[GLOBAL]</code> est obligatoire.
        </p>
        <textarea @ref="_configEditorTextarea"
              class="config-textarea config-textarea--editor @(_hasUnsavedChanges ? "config-textarea--modified" : "")"
              value="@_configText"
                  disabled="@_isActive"
                  rows="25"
                  spellcheck="false"
                  placeholder="[GLOBAL]&#10;TIMESTAMP_FORMAT=&quot;%c&quot;&#10;LISTEN_PORT=5300&#10;CODECS=OPUS"></textarea>
    </div>
}

@code {
    private ReflectorAggregate? _reflector;
    private string _configText = string.Empty;
    private string _savedConfigText = string.Empty;
    private bool _isLoading = true;
    private bool _isActive;
    private bool _isSaving;
    private bool _isToggling;
    private bool _hasUnsavedChanges;
    private bool _isEditorInitialized;
    private ElementReference _configEditorTextarea;
    private DotNetObjectReference<Index>? _dotNetRef;

/// <summary>
    /// Configuration du réflecteur créé au premier affichage. Reprise du seeder : en tenir
    /// une copie ici avait déjà divergé, et une clé ajoutée d'un côté manquait de l'autre.
    /// </summary>
    private static readonly string DefaultConfig = ReflectorSeederHostedService.GetDefaultReflectorConfig();

    private ReflectorStatusSnapshot _status = ReflectorStatusSnapshot.Unknown;
    private IReadOnlyList<ReflectorRecommendedSetting> _missingSettings = [];
    private IReadOnlyList<ReflectorConfigurationIssue> _configIssues = [];
    private bool _isApplyingSettings;

    /// <summary>La configuration comporte au moins une erreur bloquante.</summary>
    private bool HasConfigErrors =>
        _configIssues.Any(issue => issue.Severity == ReflectorConfigurationSeverity.Error);

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            // Charger le reflector existant (il devrait y en avoir un seul)
            var reflectors = await Mediator.Send<IReadOnlyList<ReflectorAggregate>>(new GetAllReflectorsQuery());

            if (reflectors.Count == 0)
            {
                // Créer le reflector par défaut au premier démarrage
                var createResult = await Mediator.Send<Validation<Error, Guid>>(
                    new CreateReflectorCommand(Guid.NewGuid(), "SvxReflector", DefaultConfig));

                createResult.IfFail(errors =>
                {
                    ToastService.ShowError("Erreur lors de l'initialisation du reflector : " + string.Join(", ", errors.Select(e => e.Message)));
                });

                // Recharger après création
                reflectors = await Mediator.Send<IReadOnlyList<ReflectorAggregate>>(new GetAllReflectorsQuery());
            }

            _reflector = reflectors.FirstOrDefault();
            _configText = _reflector?.Config ?? DefaultConfig;
            _savedConfigText = _configText;
            RefreshConfigurationAdvice();

            // Vérifier l'état du daemon
            var runningResult = await DaemonService.IsRunningAsync();
            _isActive = runningResult.Match(Succ: v => v, Fail: _ => false);

            // Le statut est poussé par le service d'interrogation : la page ne parle jamais
            // au serveur HTTP du réflecteur elle-même.
            _status = await Mediator.Send<ReflectorStatusSnapshot>(new GetReflectorStatusQuery());
            StatusService.OnStatusChanged += OnStatusChanged;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnStatusChanged(ReflectorStatusSnapshot status)
    {
        InvokeAsync(() =>
        {
            _status = status;
            StateHasChanged();
        });
    }

    private static string FormatTalkGroup(int talkGroup) =>
        talkGroup == 0 ? "aucun" : talkGroup.ToString();

    private static string FormatMonitored(IReadOnlyList<int> talkGroups) =>
        talkGroups.Count == 0 ? "—" : string.Join(", ", talkGroups);

    private static string FormatSoftware(ReflectorNodeStatus node)
    {
        var parts = new[] { node.Software, node.ProjectVersion ?? node.SoftwareVersion }
            .Where(part => !string.IsNullOrWhiteSpace(part));

        var text = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isLoading)
        {
            return;
        }

        if (!_isEditorInitialized)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);

                _isEditorInitialized = await JS.InvokeAsync<bool>(
                    "reflectorConfigEditor.init",
                    _configEditorTextarea,
                    _configText,
                    _isActive,
                    _dotNetRef);
            }
            catch (InvalidOperationException)
            {
                // Peut survenir pendant le prerendering Blazor Server.
            }
        }

        if (_isEditorInitialized)
        {
            await JS.InvokeVoidAsync("reflectorConfigEditor.setReadOnly", _isActive);
            await JS.InvokeVoidAsync("reflectorConfigEditor.refresh");
        }
    }

    private async Task SaveConfigAsync()
    {
        if (_reflector is null || _isActive)
            return;

        _isSaving = true;

        try
        {
            if (_isEditorInitialized)
            {
                _configText = await JS.InvokeAsync<string>("reflectorConfigEditor.getValue");
                _hasUnsavedChanges = _configText != _savedConfigText;
            }

            RefreshConfigurationAdvice();

            // Le domaine refuserait de toute façon, mais le dire ici nomme la ligne fautive
            // au lieu de laisser remonter un message d'erreur agrégé.
            if (HasConfigErrors)
            {
                ToastService.ShowError(
                    "Configuration non enregistrée : corrigez les erreurs de syntaxe signalées.");
                return;
            }

            var result = await Mediator.Send<Validation<Error, Unit>>(
                new UpdateReflectorConfigurationCommand(_reflector.Id, _reflector.Name, _configText));

            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Configuration sauvegardée avec succès.");
                    _savedConfigText = _configText;
                    _hasUnsavedChanges = false;
                    RefreshConfigurationAdvice();
                    return Unit.Default;
                },
                Fail: errors => { ToastService.ShowError("Erreur lors de la sauvegarde : " + string.Join(", ", errors.Select(e => e.Message))); return Unit.Default; });
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erreur inattendue : " + ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ApplyRecommendedSettingsAsync()
    {
        if (_reflector is null || _isActive)
            return;

        _isApplyingSettings = true;

        try
        {
            var result = await Mediator.Send<Validation<Error, Unit>>(
                new ApplyRecommendedSettingsCommand(_reflector.Id));

            await result.Match(
                Succ: async _ =>
                {
                    ToastService.ShowSuccess(
                        "Réglages ajoutés. Redémarrez le réflecteur pour qu'ils prennent effet.");
                    await ReloadConfigurationAsync();
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    ToastService.ShowError(string.Join(", ", errors.Select(e => e.Message)));
                    return Task.FromResult(Unit.Default);
                });
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erreur inattendue : " + ex.Message);
        }
        finally
        {
            _isApplyingSettings = false;
        }
    }

    /// <summary>
    /// Recharge la configuration depuis la base et la réinjecte dans l'éditeur.
    /// </summary>
    private async Task ReloadConfigurationAsync()
    {
        var reflectors = await Mediator.Send<IReadOnlyList<ReflectorAggregate>>(new GetAllReflectorsQuery());
        _reflector = reflectors.FirstOrDefault();
        _configText = _reflector?.Config ?? _configText;
        _savedConfigText = _configText;
        _hasUnsavedChanges = false;
        RefreshConfigurationAdvice();

        if (_isEditorInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("reflectorConfigEditor.setValue", _configText);
            }
            catch (JSException ex)
            {
                // Le texte reste juste en mémoire : un rafraîchissement de page suffit.
                ToastService.ShowInfo("Rafraîchissez la page pour voir la configuration mise à jour.");
                Console.Error.WriteLine(ex);
            }
        }
    }

    private async Task StartReflectorAsync()
    {
        if (_reflector is null)
            return;

        _isToggling = true;

        try
        {
            var result = await Mediator.Send<Validation<Error, Unit>>(
                new ActivateReflectorCommand(_reflector.Id));

            result.Match(
                Succ: _ => { _isActive = true; ToastService.ShowSuccess("Reflector démarré avec succès."); return Unit.Default; },
                Fail: errors => { ToastService.ShowError("Erreur lors du démarrage : " + string.Join(", ", errors.Select(e => e.Message))); return Unit.Default; });

            if (_isEditorInitialized)
            {
                await JS.InvokeVoidAsync("reflectorConfigEditor.setReadOnly", _isActive);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erreur inattendue : " + ex.Message);
        }
        finally
        {
            _isToggling = false;
        }
    }

    [JSInvokable]
    public void OnConfigEditorChanged(string value)
    {
        _configText = value ?? string.Empty;
        _hasUnsavedChanges = _configText != _savedConfigText;
        RefreshConfigurationAdvice();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Recalcule les remarques de syntaxe et les réglages manquants sur le texte courant.
    /// </summary>
    /// <remarks>
    /// Le validateur est une fonction pure du domaine : l'appeler à chaque frappe ne coûte
    /// rien, et signale l'erreur pendant la saisie plutôt qu'au moment d'enregistrer.
    /// </remarks>
    private void RefreshConfigurationAdvice()
    {
        _configIssues = ReflectorConfigurationValidator.Validate(_configText);
        _missingSettings = ReflectorRecommendedSettings.MissingFrom(_configText);
    }

    private async Task StopReflectorAsync()
    {
        if (_reflector is null)
            return;

        _isToggling = true;

        try
        {
            var result = await Mediator.Send<Validation<Error, Unit>>(
                new DeactivateReflectorCommand(_reflector.Id));

            result.Match(
                Succ: _ => { _isActive = false; ToastService.ShowSuccess("Reflector arrêté avec succès."); return Unit.Default; },
                Fail: errors => { ToastService.ShowError("Erreur lors de l'arrêt : " + string.Join(", ", errors.Select(e => e.Message))); return Unit.Default; });

            if (_isEditorInitialized)
            {
                await JS.InvokeVoidAsync("reflectorConfigEditor.setReadOnly", _isActive);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erreur inattendue : " + ex.Message);
        }
        finally
        {
            _isToggling = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Le poller est un singleton : un circuit qui reste abonné après sa fermeture
        // maintiendrait le composant en vie et redessinerait dans le vide.
        StatusService.OnStatusChanged -= OnStatusChanged;

        if (_isEditorInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("reflectorConfigEditor.dispose");
            }
            catch (JSDisconnectedException)
            {
                // Ignore when client disconnects during component disposal.
            }
        }

        _dotNetRef?.Dispose();
    }
}

<style>
    .reflector-advice {
        margin: 8px 0 0;
        padding-left: 18px;
    }

        .reflector-advice li {
            margin-bottom: 6px;
        }

        .reflector-advice code {
            margin-right: 6px;
        }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .page-title-group {
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .page-title-group h1 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.6rem;
            margin: 0;
        }

    .header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
