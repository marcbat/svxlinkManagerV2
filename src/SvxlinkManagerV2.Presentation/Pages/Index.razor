@page "/"
@implements IDisposable
@using SvxlinkManagerV2.Application.Features.Salons.GetActiveSalon
@using SvxlinkManagerV2.Application.Features.Salons.GetAllSalons
@using SvxlinkManagerV2.Application.Features.Salons.ActivateSalon
@using SvxlinkManagerV2.Application.Features.Salons.DeactivateSalon
@using SvxlinkManagerV2.Application.Features.SA818.GetSA818Configuration
@using SvxlinkManagerV2.Application.Features.SA818
@using SvxlinkManagerV2.Application.Features.Sounds.GetAllSounds
@using SvxlinkManagerV2.Application.Interfaces
@using SvxlinkManagerV2.Application.Models
@using SvxlinkManagerV2.Domain.Aggregates.Salon
@using SvxlinkManagerV2.Domain.Aggregates.SA818
@using SvxlinkManagerV2.Domain.Aggregates.Sound
@using SvxlinkManagerV2.Domain.Common

@inject IMediator Mediator
@inject ISvxLinkDaemonService DaemonService
@inject IConnectedNodesService ConnectedNodesService
@inject ToastService ToastService

<!-- ── Page Header ─────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">@DateTime.Now.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</p>
    </div>
    <div class="page-header-meta">
        @if (_daemonRunning)
        {
            <span class="badge badge-success">
                <span class="material-symbols-outlined">cell_tower</span>
                Connecté
            </span>
        }
        else
        {
            <span class="badge badge-danger">
                <span class="material-symbols-outlined">cell_tower</span>
                Hors ligne
            </span>
        }
    </div>
</div>

<!-- ── Stats Grid ────────────────────────────────────────────── -->
<div class="stats-grid">

    <!-- Card : Salon Actif -->
    <div class="card">
        <div class="card-title">
            <span class="material-symbols-outlined">dns</span>
            Salon Actif
        </div>
        @if (_isLoading)
        {
            <div class="skeleton" style="height:24px;width:70%;margin-bottom:8px;"></div>
            <div class="skeleton" style="height:16px;width:50%;"></div>
        }
        else if (_activeSalon is not null)
        {
            <div class="card-value">@_activeSalon.Name</div>
            <div class="card-meta">
                <span class="badge badge-success">Actif</span>
            </div>
        }
        else
        {
            <div class="card-value" style="font-size:16px;color:var(--text-muted)">Aucun salon actif</div>
            <div class="card-meta">
                <span class="badge badge-muted">Inactif</span>
            </div>
        }
    </div>

    <!-- Card : État SVXLink -->
    <div class="card">
        <div class="card-title">
            <span class="material-symbols-outlined">settings_input_component</span>
            État SVXLink
        </div>
        @if (_isLoading)
        {
            <div class="skeleton" style="height:24px;width:70%;margin-bottom:8px;"></div>
            <div class="skeleton" style="height:16px;width:50%;"></div>
        }
        else if (_daemonRunning)
        {
            <div class="card-value">En cours d'exécution</div>
            <div class="card-meta">
                <span class="material-symbols-outlined" style="font-size:16px;color:var(--success)">check_circle</span>
                Daemon actif
            </div>
        }
        else
        {
            <div class="card-value" style="color:var(--danger)">Arrêté</div>
            <div class="card-meta">
                <span class="material-symbols-outlined" style="font-size:16px;color:var(--danger)">cancel</span>
                Daemon inactif
            </div>
        }
    </div>

    <!-- Card : Module SA818 -->
    <div class="card">
        <div class="card-title">
            <span class="material-symbols-outlined">settings_input_component</span>
            Module SA818
        </div>
        @if (_isLoading)
        {
            <div class="skeleton" style="height:24px;width:70%;margin-bottom:8px;"></div>
            <div class="skeleton" style="height:16px;width:60%;"></div>
        }
        else if (_sa818Dto is not null)
        {
            <div class="card-value">Vol: @_sa818Dto.Volume&nbsp;|&nbsp;SQL: @_sa818Dto.Squelch</div>
            <div class="card-meta">
                <span class="material-symbols-outlined" style="font-size:16px;color:var(--accent)">radio</span>
                Bande: @(_sa818Dto.Bandwidth == SA818Bandwidth.Wide25kHz ? "25 kHz" : "12.5 kHz")
            </div>
            @if (_sa818Dto.RxFrequency.HasValue)
            {
                <div class="card-meta">
                    <span class="material-symbols-outlined" style="font-size:16px;color:var(--text-muted)">arrow_downward</span>
                    RX: @_sa818Dto.RxFrequency.Value.ToString("F3") MHz
                </div>
            }
            @if (_sa818Dto.TxFrequency.HasValue)
            {
                <div class="card-meta">
                    <span class="material-symbols-outlined" style="font-size:16px;color:var(--text-muted)">arrow_upward</span>
                    TX: @_sa818Dto.TxFrequency.Value.ToString("F3") MHz
                </div>
            }
            @if (_sa818Dto.RxCtcss.HasValue)
            {
                <div class="card-meta">
                    <span class="material-symbols-outlined" style="font-size:16px;color:var(--text-muted)">tune</span>
                    CTCSS RX: @_sa818Dto.RxCtcss.Value.ToString("F1") Hz
                </div>
            }
            @if (_sa818Dto.TxCtcss.HasValue)
            {
                <div class="card-meta">
                    <span class="material-symbols-outlined" style="font-size:16px;color:var(--text-muted)">tune</span>
                    CTCSS TX: @_sa818Dto.TxCtcss.Value.ToString("F1") Hz
                </div>
            }
        }
        else
        {
            <div class="card-value" style="color:var(--text-muted);font-size:16px">Non configuré</div>
        }
    </div>

    <!-- Card : Sons -->
    <div class="card">
        <div class="card-title">
            <span class="material-symbols-outlined">library_music</span>
            Sons
        </div>
        @if (_isLoading)
        {
            <div class="skeleton" style="height:24px;width:50%;margin-bottom:8px;"></div>
            <div class="skeleton" style="height:16px;width:60%;"></div>
        }
        else
        {
            <div class="card-value">@_sounds.Count fichier@(_sounds.Count != 1 ? "s" : "")</div>
            <div class="card-meta">
                <span class="material-symbols-outlined" style="font-size:16px;color:var(--warning)">storage</span>
                Bibliothèque locale
            </div>
        }
    </div>

</div>

<!-- ── Dashboard Bottom Grid ─────────────────────────────────── -->
<div class="dashboard-grid">

    <!-- Actions rapides -->
    <div class="card">
        <div class="section-header">
            <span class="material-symbols-outlined">bolt</span>
            Actions rapides
        </div>

        <div class="actions-stack">
            <div class="form-group">
                <label class="form-label">Activer un salon</label>
                <div class="action-group">
                    <select class="form-select" @bind="_selectedSalonId" disabled="@(_isActivating || _isDeactivating)">
                        <option value="">— Choisir un salon —</option>
                        @foreach (var salon in _salons.Where(s => s.Id != _activeSalon?.Id && !s.IsDeleted))
                        {
                            <option value="@salon.Id">@(string.IsNullOrWhiteSpace(salon.Name) ? "(sans nom)" : salon.Name)@(salon.IsDefault ? " ★" : "")</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm"
                            disabled="@(_selectedSalonId == null || _isActivating || _isDeactivating)"
                            @onclick="ActivateSalon">
                        @if (_isActivating)
                        {
                            <span class="material-symbols-outlined" style="animation:spin 1s linear infinite">progress_activity</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">play_arrow</span>
                        }
                        Activer
                    </button>
                </div>
            </div>

            <div class="divider" style="margin:6px 0;"></div>

            <div>
                <button class="btn btn-danger btn-sm"
                        disabled="@(_activeSalon is null || _isDeactivating || _isActivating)"
                        @onclick="DeactivateSalon">
                    @if (_isDeactivating)
                    {
                        <span class="material-symbols-outlined" style="animation:spin 1s linear infinite">progress_activity</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">power_settings_new</span>
                    }
                    Désactiver le salon actif
                </button>
            </div>
        </div>
    </div>

    <!-- Nœuds connectés -->
    <div class="card">
        <div class="section-header">
            <span class="material-symbols-outlined">hub</span>
            Nœuds connectés
            @if (_connectedNodes.Count > 0)
            {
                <span class="badge badge-accent" style="margin-left:8px;">@_connectedNodes.Count</span>
            }
        </div>

        @if (_connectedNodes.Count > 0)
        {
            <div class="node-list">
                @foreach (var node in _connectedNodes.OrderBy(n => n.Name))
                {
                    <div class="node-chip">
                        <span class="material-symbols-outlined" style="font-size:16px;">radio_button_checked</span>
                        @node.Name
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">hub</span>
                <p>Aucun nœud connecté.<br />Les nœuds apparaîtront ici une fois le salon actif.</p>
            </div>
        }
    </div>

</div>

<style>
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    
    .node-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }
    
    .node-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: rgba(101, 133, 255, 0.15);
        border: 1px solid rgba(101, 133, 255, 0.3);
        border-radius: 16px;
        color: var(--text-primary);
        font-size: 14px;
        font-weight: 500;
        cursor: default;
        user-select: none;
        transition: all 0.2s ease;
    }
    
    .node-chip:hover {
        background: rgba(101, 133, 255, 0.25);
        border-color: rgba(101, 133, 255, 0.5);
    }
    
    .node-chip .material-symbols-outlined {
        color: var(--accent);
    }
</style>

@code {
    private SalonAggregate?              _activeSalon;
    private SA818ConfigurationDto?       _sa818Dto;
    private IReadOnlyList<SoundAggregate> _sounds  = [];
    private IReadOnlyList<SalonAggregate> _salons  = [];
    private List<ConnectedNodeInfo>      _connectedNodes = new();
    private bool _daemonRunning;
    private bool _isLoading = true;
    private Guid? _selectedSalonId;
    private bool _isActivating;
    private bool _isDeactivating;

    private PeriodicTimer? _statusTimer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StartDaemonPolling();
        
        // Charger les nœuds connectés et s'abonner aux événements
        _connectedNodes = ConnectedNodesService.ConnectedNodes.ToList();
        ConnectedNodesService.OnNodeJoined += OnNodeJoined;
        ConnectedNodesService.OnNodeLeft += OnNodeLeft;
        ConnectedNodesService.OnNodesInitialized += OnNodesInitialized;
    }

    private void StartDaemonPolling()
    {
        _cts = new CancellationTokenSource();
        _statusTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollDaemonStatusAsync(_cts.Token);
    }

    private async Task PollDaemonStatusAsync(CancellationToken ct)
    {
        try
        {
            while (await _statusTimer!.WaitForNextTickAsync(ct))
            {
                var result = await DaemonService.IsRunningAsync(ct);
                var isRunning = result.Match(Succ: b => b, Fail: _ => false);

                if (isRunning != _daemonRunning)
                {
                    _daemonRunning = isRunning;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private void OnNodeJoined(ConnectedNodeInfo node)
    {
        InvokeAsync(() =>
        {
            if (!_connectedNodes.Any(n => n.Name == node.Name))
            {
                _connectedNodes.Add(node);
            }
            ToastService.ShowInfo($"{node.Name} a rejoint le salon", "Nœud connecté", 4000);
            StateHasChanged();
        });
    }

    private void OnNodeLeft(ConnectedNodeInfo node)
    {
        InvokeAsync(() =>
        {
            _connectedNodes.RemoveAll(n => n.Name == node.Name);
            ToastService.ShowInfo($"{node.Name} a quitté le salon", "Nœud déconnecté", 4000);
            StateHasChanged();
        });
    }

    private void OnNodesInitialized(IReadOnlyList<ConnectedNodeInfo> nodes)
    {
        InvokeAsync(() =>
        {
            _connectedNodes = nodes.ToList();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        // Désabonnement des événements de nœuds connectés
        ConnectedNodesService.OnNodeJoined -= OnNodeJoined;
        ConnectedNodesService.OnNodeLeft -= OnNodeLeft;
        ConnectedNodesService.OnNodesInitialized -= OnNodesInitialized;
        
        _cts?.Cancel();
        _cts?.Dispose();
        _statusTimer?.Dispose();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        var loadErrors = new List<string>();

        try
        {
            try
            {
                _activeSalon = await Mediator.Send<SalonAggregate?>(new GetActiveSalonQuery());
            }
            catch (Exception ex)
            {
                _activeSalon = null;
                loadErrors.Add($"salon actif: {ex.Message}");
            }

            try
            {
                var sa818Result = await Mediator.Send<Validation<Error, SA818ConfigurationDto>>(new GetSA818ConfigurationQuery());
                _sa818Dto = sa818Result.Match(Succ: dto => (SA818ConfigurationDto?)dto, Fail: _ => null);
            }
            catch (Exception ex)
            {
                _sa818Dto = null;
                loadErrors.Add($"configuration SA818: {ex.Message}");
            }

            try
            {
                _sounds = await Mediator.Send<IReadOnlyList<SoundAggregate>>(new GetAllSoundsQuery()) ?? [];
            }
            catch (Exception ex)
            {
                _sounds = [];
                loadErrors.Add($"sons: {ex.Message}");
            }

            try
            {
                _salons = await Mediator.Send<IReadOnlyList<SalonAggregate>>(new GetAllSalonsQuery()) ?? [];
            }
            catch (Exception ex)
            {
                _salons = [];
                loadErrors.Add($"salons: {ex.Message}");
            }

            try
            {
                var daemonResult = await DaemonService.IsRunningAsync();
                _daemonRunning = daemonResult.Match(Succ: b => b, Fail: _ => false);
            }
            catch (Exception ex)
            {
                _daemonRunning = false;
                loadErrors.Add($"état du daemon SVXLink: {ex.Message}");
            }
        }
        finally
        {
            _isLoading = false;
        }

        if (loadErrors.Count > 0)
        {
            ToastService.ShowError($"Erreur partielle de chargement du dashboard : {string.Join(" | ", loadErrors)}");
        }
    }

    private async Task ActivateSalon()
    {
        if (_selectedSalonId is null) return;
        _isActivating = true;
        try
        {
            var result = await Mediator.Send<Validation<Error, Unit>>(new ActivateSalonCommand(_selectedSalonId.Value));
            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Salon activé avec succès.");
                    _selectedSalonId = null;
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    ToastService.ShowError(string.Join(", ", errors.Select(e => e.Message)));
                    return Unit.Default;
                }
            );
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur : {ex.Message}");
        }
        finally
        {
            _isActivating = false;
        }
    }

    private async Task DeactivateSalon()
    {
        if (_activeSalon is null) return;
        _isDeactivating = true;
        try
        {
            var result = await Mediator.Send<Validation<Error, Unit>>(new DeactivateSalonCommand(_activeSalon.Id));
            result.Match(
                Succ: _ =>
                {
                    ToastService.ShowSuccess("Salon désactivé.");
                    return Unit.Default;
                },
                Fail: errors =>
                {
                    ToastService.ShowError(string.Join(", ", errors.Select(e => e.Message)));
                    return Unit.Default;
                }
            );
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erreur : {ex.Message}");
        }
        finally
        {
            _isDeactivating = false;
        }
    }
}
