    /// </summary>
    private string CertificateExplanation => _certificate.Status switch
    {
        NodeCertificateStatus.NotGenerated =>
            "Le nœud n'a pas encore généré sa clé. Elle est créée au premier démarrage de "
            + "SVXLink sur un salon en protocole V3.",
        NodeCertificateStatus.PendingSignature =>
            "La demande de signature a été transmise au réflecteur et attend la décision de "
            + "son sysop. Ce n'est pas une panne : l'attente peut durer des heures ou des "
            + "jours, et le nœud se connectera de lui-même une fois la demande signée."
            + (_certificate.RequestedAt is { } requested
                ? $" Demande déposée le {requested:dd/MM/yyyy à HH:mm}."
                : string.Empty),
        NodeCertificateStatus.Valid =>
            "Le nœud dispose d'un certificat valide.",
        NodeCertificateStatus.Expiring =>
            $"Le certificat expire dans moins de {NodeCertificateState.ExpiryWarningDays} jours. "
            + "Régénérez la demande sans attendre : la signature dépend du sysop du réflecteur.",
        NodeCertificateStatus.Expired =>
            "Le certificat a expiré et le réflecteur le refusera. Régénérez la demande.",
        _ => "Le certificat est présent mais illisible. Régénérer la demande le remplacera."
