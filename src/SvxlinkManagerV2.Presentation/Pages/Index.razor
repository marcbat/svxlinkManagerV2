@page "/"
@using SvxlinkManagerV2.Application.Features.Salons.GetAllSalons
@using SvxlinkManagerV2.Application.Features.Salons.GetActiveSalon
@using SvxlinkManagerV2.Application.Features.Salons.ActivateSalon
@using SvxlinkManagerV2.Application.Features.Salons.DeactivateSalon
@using SvxlinkManagerV2.Domain.Aggregates.Salon
@using Wolverine
@inject IMessageBus MessageBus

<PageTitle>Accueil - SvxLink Manager V2</PageTitle>

<div class="container">
    <div class="card p-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-broadcast-pin text-primary"></i>
                    Tableau de bord
                </h2>
                @if (_activeSalon != null)
                {
                    <StatusBadge Status="@GetCurrentStatus()" />
                }
                else if (_isLoadingSalons)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                }
                else
                {
                    <StatusBadge Status="Inactif" />
                }
            </div>

            @if (_validationResult != null)
            {
                <ErrorDisplay ValidationResult="@_validationResult" />
            }

            @if (_isLoadingSalons)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p class="text-muted mt-3">Chargement des salons...</p>
                </div>
            }
            else
            {
                <SalonDropdown 
                    Salons="@_allSalons"
                    SelectedSalonId="@_selectedSalonId"
                    OnSelectionChanged="@HandleSalonSelection"
                    IsDisabled="@_isProcessing"
                    Label="Sélectionner un salon"
                    ShowDisconnectOption="true"
                    ShowPerroquetOption="true" />

                <div class="d-grid gap-2 mt-3">
                    <button 
                        class="btn btn-success btn-lg" 
                        @onclick="HandleActivateClick"
                        disabled="@(string.IsNullOrEmpty(_selectedSalonId) || _isProcessing)">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Traitement en cours...</span>
                        }
                        else
                        {
                            <i class="bi bi-play-circle me-2"></i>
                            <span>Activer</span>
                        }
                    </button>
                </div>

                @if (_activeSalon != null)
                {
                    <div class="card bg-light mt-4">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Salon actif
                            </h5>
                            <p class="mb-1"><strong>Nom:</strong> @_activeSalon.Name</p>
                            <p class="mb-1"><strong>Host:</strong> @_activeSalon.Configuration.Host</p>
                            <p class="mb-0"><strong>Port:</strong> @_activeSalon.Configuration.Port</p>
                        </div>
                    </div>
                }

                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-diagram-3 me-2"></i>
                            Nœuds connectés (TalkGroups)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-0" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            Aucun nœud connecté pour le moment
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<SalonAggregate>? _allSalons;
    private SalonAggregate? _activeSalon;
    private string? _selectedSalonId;
    private bool _isLoadingSalons = true;
    private bool _isProcessing = false;
    private object? _validationResult;
    private System.Threading.Timer? _pollingTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadSalonsAsync();
        await LoadActiveSalonAsync();
        StartPolling();
    }

    private async Task LoadSalonsAsync()
    {
        try
        {
            _isLoadingSalons = true;
            _allSalons = await MessageBus.InvokeAsync<IReadOnlyList<SalonAggregate>>(new GetAllSalonsQuery());
        }
        catch (Exception)
        {
            _validationResult = new { Message = "Erreur lors du chargement des salons" };
        }
        finally
        {
            _isLoadingSalons = false;
        }
    }

    private async Task LoadActiveSalonAsync()
    {
        try
        {
            _activeSalon = await MessageBus.InvokeAsync<SalonAggregate?>(new GetActiveSalonQuery());
        }
        catch (Exception)
        {
            // Pas d'erreur affichée pour éviter de polluer l'UI
        }
    }

    private void StartPolling()
    {
        _pollingTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadActiveSalonAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private Task HandleSalonSelection(string salonId)
    {
        _selectedSalonId = salonId;
        _validationResult = null;
        return Task.CompletedTask;
    }

    private async Task HandleActivateClick()
    {
        if (string.IsNullOrEmpty(_selectedSalonId))
            return;

        _isProcessing = true;
        _validationResult = null;

        try
        {
            if (_selectedSalonId == "disconnect")
            {
                // Déconnecter le salon actif
                if (_activeSalon != null)
                {
                    var result = await MessageBus.InvokeAsync<LanguageExt.Validation<SvxlinkManagerV2.Domain.Common.Error, LanguageExt.Unit>>(new DeactivateSalonCommand(_activeSalon.Id));
                    _validationResult = result;
                    
                    if (result.IsSuccess)
                    {
                        _selectedSalonId = null;
                        await LoadActiveSalonAsync();
                    }
                }
            }
            else if (_selectedSalonId == "perroquet")
            {
                // Désactiver le salon actif pour le mode perroquet
                if (_activeSalon != null)
                {
                    var result = await MessageBus.InvokeAsync<LanguageExt.Validation<SvxlinkManagerV2.Domain.Common.Error, LanguageExt.Unit>>(new DeactivateSalonCommand(_activeSalon.Id));
                    _validationResult = result;
                    await LoadActiveSalonAsync();
                }
                // TODO: Activer mode perroquet (feature désactivée pour MVP)
            }
            else if (Guid.TryParse(_selectedSalonId, out var salonId))
            {
                // Désactiver le salon actif si présent
                if (_activeSalon != null)
                {
                    await MessageBus.InvokeAsync<LanguageExt.Validation<SvxlinkManagerV2.Domain.Common.Error, LanguageExt.Unit>>(new DeactivateSalonCommand(_activeSalon.Id));
                }

                // Activer le nouveau salon
                var result = await MessageBus.InvokeAsync<LanguageExt.Validation<SvxlinkManagerV2.Domain.Common.Error, LanguageExt.Unit>>(new ActivateSalonCommand(salonId));
                _validationResult = result;
                
                if (result.IsSuccess)
                {
                    _selectedSalonId = null;
                    await LoadActiveSalonAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _validationResult = new { Message = $"Erreur: {ex.Message}" };
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetCurrentStatus()
    {
        if (_activeSalon != null)
        {
            return _activeSalon.IsActive ? "Actif" : "Inactif";
        }
        return "Inactif";
    }

    public void Dispose()
    {
        _pollingTimer?.Dispose();
    }
}
