@page "/"

<PageTitle>Accueil - SvxLink Manager V2</PageTitle>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center p-5">
                <h1 class="display-4 mb-4">
                    <i class="bi bi-broadcast-pin text-primary"></i>
                </h1>
                <h2 class="mb-3">Bienvenue sur SvxLink Manager V2</h2>
                <p class="lead text-muted">
                    Gestionnaire de configuration pour nœuds radioamateurs SVXLink
                </p>
                <hr class="my-4">
                <p class="text-muted">
                    Sélectionnez une section dans le menu de navigation pour commencer.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body text-center">
                <i class="bi bi-globe display-6 text-primary"></i>
                <h5 class="card-title mt-3">Salons</h5>
                <p class="card-text small text-muted">Gérez vos connexions aux salons reflecteurs</p>
                <a href="/salons" class="btn btn-outline-primary btn-sm">Accéder</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body text-center">
                <i class="bi bi-broadcast display-6 text-info"></i>
                <h5 class="card-title mt-3">Configuration Radio</h5>
                <p class="card-text small text-muted">Paramètres du module SA818</p>
                <a href="/radio-profile" class="btn btn-outline-info btn-sm">Accéder</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <i class="bi bi-music-note-beamed display-6 text-success"></i>
                <h5 class="card-title mt-3">Sons</h5>
                <p class="card-text small text-muted">Bibliothèque de fichiers audio WAV</p>
                <a href="/sounds" class="btn btn-outline-success btn-sm">Accéder</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card border-secondary">
            <div class="card-body text-center">
                <i class="bi bi-info-circle display-6 text-secondary"></i>
                <h5 class="card-title mt-3">À propos</h5>
                <p class="card-text small text-muted">Informations système et version</p>
                <button class="btn btn-outline-secondary btn-sm" disabled>Bientôt disponible</button>
            </div>
        </div>
    </div>
</div>

@code {
    // Page d'accueil avec liens rapides vers les sections principales
}
