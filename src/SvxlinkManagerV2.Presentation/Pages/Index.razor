    /// <summary>
    /// Les talkgroups n'existent qu'en protocole V3 : un salon V2 ne sait pas les sélectionner,
    /// et un perroquet n'a pas de liaison réflecteur du tout.
    /// </summary>
    private bool SupportsTalkGroups =>
        _activeSalon is not null
        && _activeSalon.SalonType != SalonType.Parrot
        && _activeSalon.Configuration.ReflectorProtocol == ReflectorProtocol.V3;

    private int DefaultTalkGroup => _activeSalon?.Configuration.DefaultTg ?? 0;

    private string CurrentTalkGroupLabel =>
        _talkGroupState.TalkGroup is { } tg ? (tg == 0 ? "aucun" : tg.ToString()) : "inconnu";

    /// <summary>
    /// Ce qui a provoqué la sélection courante. SVXLink distingue lui-même ces origines :
    /// sans elles, un QSY décidé par le réflecteur ressemble à une manœuvre de l'opérateur.
    /// </summary>
    private string? TalkGroupOriginLabel => _talkGroupState.Origin switch
    {
        TalkGroupActivationOrigin.Local => "activité locale",
        TalkGroupActivationOrigin.Remote => "activité distante",
        TalkGroupActivationOrigin.Priority => "talkgroup prioritaire",
        TalkGroupActivationOrigin.Command => "commande DTMF",
        TalkGroupActivationOrigin.Default => "talkgroup par défaut",
        TalkGroupActivationOrigin.Qsy => "QSY du réflecteur",
        TalkGroupActivationOrigin.Timeout => "délai écoulé",
        _ => null
    };

    /// <summary>
    /// Talkgroups proposés : le TG par défaut du salon et ceux de MONITOR_TGS. Un TG hors
    /// liste reste saisissable dans le champ voisin.
    /// </summary>
    private IEnumerable<int> AvailableTalkGroups
    {
        get
        {
            var talkGroups = new List<int> { DefaultTalkGroup };
            talkGroups.AddRange(ParseMonitorTgs(_activeSalon?.Configuration.MonitorTgs));

            if (_talkGroupState.TalkGroup is { } current)
                talkGroups.Add(current);

            // Une surveillance temporaire ajoutée en DTMF doit rester atteignable depuis
            // l'interface, sans quoi il faudrait retaper le numéro à la main.
            talkGroups.AddRange(_talkGroupState.TemporaryMonitors);

            return talkGroups.Distinct().OrderBy(tg => tg);
        }
    }

    /// <summary>
    /// MONITOR_TGS est une liste séparée par des virgules dont chaque entrée peut porter un
    /// suffixe de priorité (« 226+ ») : seuls les chiffres de tête sont un numéro de TG.
    /// </summary>
    private static IEnumerable<int> ParseMonitorTgs(string? monitorTgs)
    {
        if (string.IsNullOrWhiteSpace(monitorTgs))
            yield break;

        foreach (var entry in monitorTgs.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var digits = new string(entry.TakeWhile(char.IsDigit).ToArray());
            if (int.TryParse(digits, out var talkGroup))
                yield return talkGroup;
        }
    }

