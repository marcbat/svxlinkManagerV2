    };

    /// <summary>
    /// Le regroupement n'a de sens qu'en V3, et seulement si l'on connaît réellement le
    /// talkgroup des nœuds : sur un réflecteur distant l'API de statut n'est pas
    /// accessible, et tout regrouper sous « aucun » serait pire que la liste plate.
    /// </summary>
    private bool GroupNodesByTalkGroup =>
        SupportsTalkGroups && _connectedNodes.Any(node => node.TalkGroup.HasValue);

    /// <summary>
    /// Nœuds groupés par talkgroup, celui du nœud local en tête puis par numéro croissant.
    /// Un nœud dont le talkgroup est inconnu est rangé avec « aucun ».
    /// </summary>
    private IEnumerable<IGrouping<int, ConnectedNodeInfo>> NodesByTalkGroup =>
        _connectedNodes
            .GroupBy(node => node.TalkGroup ?? 0)
            .OrderByDescending(group => group.Key == _talkGroupState.TalkGroup)
            .ThenBy(group => group.Key);

    private bool IsCurrentNode(ConnectedNodeInfo node)
    {
        var currentCallsign = _activeSalon?.Configuration.Callsign;
        if (string.IsNullOrWhiteSpace(currentCallsign))
        {
            return false;
        }

        return string.Equals(node.Name?.Trim(), currentCallsign.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private string GetNodeChipCss(ConnectedNodeInfo node)
    {
        var classes = new List<string> { "node-chip" };

        if (IsCurrentNode(node))
        {
            classes.Add("node-chip--current");
        }

        if (node.IsTx)
        {
            classes.Add("node-chip--tx");
        }

        return string.Join(' ', classes);
    }
