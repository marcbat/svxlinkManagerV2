        ReflectorLinkFailureReason.ServerCertificateUntrusted =>
            "Le réflecteur a changé d'autorité de certification. Faites oublier au nœud "
            + "celle qu'il connaît : il retéléchargera la nouvelle et SVXLink redémarrera. "
            + "Si le réflecteur a régénéré toute sa PKI, le certificat de ce nœud devra "
            + "aussi être signé à nouveau par son administrateur.",
        ReflectorLinkFailureReason.CertificateRejected =>
            "Le certificat de ce nœud n'est plus valide. Il doit être signé à nouveau par "
            + "l'administrateur du réflecteur.",
        ReflectorLinkFailureReason.ConfigurationInvalid =>
            "La configuration du salon actif est incomplète : vérifiez l'adresse du "
            + "réflecteur et l'indicatif dans la fiche du salon.",
        _ => null
