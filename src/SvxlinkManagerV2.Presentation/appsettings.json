{
  "ConnectionStrings": {
    "SQLite": "Data Source=data/svxlinkmanager.db"
  },
  "SA818": {
    "SerialPort": "/dev/ttyS2",
    "BaudRate": 9600,
    "ReadTimeout": 2000,
    "WriteTimeout": 2000,
    "CommandDelay": 1000,
    "UseMock": false
  },
  "SvxLink": {
    "ConfigPath": "/etc/svxlink/svxlink.conf",
    "UseMockDaemon": false
  },
  "Seed": {
    "AudioDirectory": "/app/audio"
  },
  "Wifi": {
    "UseMock": false
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "Owner": "marcbat",
    "Repository": "svxlinkManagerV2",
    "GitHubToken": "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",
    "PackagePattern": ".deb",
    "Channel": "Stable",
    "StagingDirectory": "data/updates",
    "InstallCommand": "/app/install-update.sh",
    "InstallArguments": "{packagePath}",
    "InstallCommandTimeoutSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SvxlinkManagerV2.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
