{
  "ConnectionStrings": {
    "SQLite": "Data Source=data/svxlinkmanager.db"
  },
  "SA818": {
    "SerialPort": "/dev/ttyS2",
    "BaudRate": 9600,
    "ReadTimeout": 2000,
    "WriteTimeout": 2000,
    "CommandDelay": 1000,
    "UseMock": false
  },
  "SvxLink": {
    "ConfigPath": "/etc/svxlink/svxlink.conf",
    "UseMockDaemon": false
  },
  "Seed": {
    "AudioDirectory": "audio"
  },
  "SystemControl": {
    "Enabled": true,
    "UseMock": false,
    "RebootCommand": "systemctl reboot",
    "ShutdownCommand": "systemctl poweroff",
    "DelayBeforeCommandSeconds": 3
  },
  "Wifi": {
    "UseMock": false
  },
  "SystemMonitoring": {
    "SystemMountPath": "/",
    "DataPath": "data",
    "CpuTemperatureWarningCelsius": 65,
    "CpuTemperatureCriticalCelsius": 75,
    "DiskUsageWarningPercent": 80,
    "DiskUsageCriticalPercent": 90,
    "MemoryUsageWarningPercent": 85,
    "MemoryUsageCriticalPercent": 95
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "Owner": "marcbat",
    "Repository": "svxlinkManagerV2",
    "GitHubToken": "",
    "PackagePattern": ".deb",
    "Channel": "Stable",
    "StagingDirectory": "data/updates",
    "InstallCommand": "/app/install-update.sh",
    "InstallArguments": "{packagePath}",
    "InstallCommandTimeoutSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SvxlinkManagerV2.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
