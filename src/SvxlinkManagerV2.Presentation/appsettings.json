{
  "ConnectionStrings": {
    "SQLite": "Data Source=data/svxlinkmanager.db"
  },
  "SA818": {
    "SerialPort": "/dev/ttyS2",
    "BaudRate": 9600,
    "ReadTimeout": 2000,
    "WriteTimeout": 2000,
    "CommandDelay": 1000,
    "UseMock": false
  },
  "SvxLink": {
    "ConfigPath": "/etc/svxlink/svxlink.conf",
    "UseMockDaemon": false
  },
  "Wifi": {
    "UseMock": false
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "Owner": "marcbat",
    "Repository": "svxlinkManagerV2",
    "PackagePattern": ".deb",
    "Channel": "Stable"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SvxlinkManagerV2.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
