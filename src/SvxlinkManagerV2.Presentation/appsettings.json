{
  "ConnectionStrings": {
    "SQLite": "Data Source=data/svxlinkmanager.db"
  },
  "SA818": {
    "SerialPort": "/dev/ttyS2",
    "BaudRate": 9600,
    "ReadTimeout": 2000,
    "WriteTimeout": 2000,
    "CommandDelay": 1000,
    "UseMock": false
  },
  "SvxLink": {
    "ConfigPath": "/etc/svxlink/svxlink.conf",
    "UseMockDaemon": false
  },
  "LocalReflector": {
    "Host": "127.0.0.1",
    "Port": 5300
  },
  "Seed": {
    "AudioDirectory": "audio"
  },
  "SystemControl": {
    "Enabled": true,
    "UseMock": false,
    "RebootCommand": "systemctl reboot",
    "ShutdownCommand": "systemctl poweroff",
    "DelayBeforeCommandSeconds": 3
  },
  "Wifi": {
    "UseMock": false
  },
  "Audio": {
    "UseMock": false,
    "CardIndex": 0,
    "CaptureControl": "ADC Gain",
    "PlaybackControl": "Line Out",
    "AmixerPath": "amixer",
    "CommandTimeoutSeconds": 5,
    "PttGpioPath": "/sys/class/gpio",
    "PttPin": "gpio7",
    "PttTestDurationSeconds": 5,
    "PttTestMaxDurationSeconds": 30
  },
  "SystemMonitoring": {
    "SystemMountPath": "/",
    "DataPath": "data",
    "CpuTemperatureWarningCelsius": 65,
    "CpuTemperatureCriticalCelsius": 75,
    "DiskUsageWarningPercent": 80,
    "DiskUsageCriticalPercent": 90,
    "MemoryUsageWarningPercent": 85,
    "MemoryUsageCriticalPercent": 95
  },
  "Statistics": {
    "RetentionDays": 90,
    "PurgeIntervalHours": 12,
    "TopCallsignCount": 10,
    "TopDtmfCodeCount": 10,
    "TimelineEntryCount": 200
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "PackageName": "svxlinkmanagerv2",
    "RepositoryUrl": "https://marcbat.github.io/svxlinkManagerV2",
    "Architecture": "armhf",
    "Component": "main",
    "SourceListPath": "/etc/apt/sources.list.d/svxlinkmanager.list",
    "KeyringPath": "/etc/apt/keyrings/svxlinkmanager.gpg",
    "ReleaseNotesRepository": "marcbat/svxlinkManagerV2",
    "DefaultChannel": "Stable",
    "CommandTimeoutSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SvxlinkManagerV2.Infrastructure": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
