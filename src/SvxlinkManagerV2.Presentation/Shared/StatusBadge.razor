@* Composant Bootstrap 5.3 pour afficher le badge d'état d'un salon *@

@if (!string.IsNullOrEmpty(Status))
{
    <span class="badge @GetBadgeClass()">
        @GetStatusIcon() @Status
    </span>
}

@code {
    /// <summary>
    /// Statut à afficher: "Actif", "Inactif", "Perroquet"
    /// </summary>
    [Parameter]
    public string? Status { get; set; }

    /// <summary>
    /// Détermine la classe CSS Bootstrap en fonction du statut
    /// </summary>
    private string GetBadgeClass() => Status?.ToLowerInvariant() switch
    {
        "actif" => "bg-success",
        "perroquet" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    /// <summary>
    /// Retourne l'icône appropriée selon le statut
    /// </summary>
    private string GetStatusIcon() => Status?.ToLowerInvariant() switch
    {
        "actif" => "●",
        "perroquet" => "◎",
        _ => "○"
    };
}
