@using SvxlinkManagerV2.Domain.Aggregates.Salon

@* Composant Bootstrap 5.3 dropdown pour la sélection d'un salon *@

<div class="mb-3">
    <label for="salonSelect" class="form-label">@Label</label>
    <select id="salonSelect" 
            class="form-select form-select-lg @(IsDisabled ? "disabled" : "")" 
            value="@SelectedSalonId" 
            @onchange="OnSalonChanged"
            disabled="@IsDisabled">
        
        <option value="">-- Sélectionnez un salon --</option>
        
        @if (ShowDisconnectOption)
        {
            <option value="disconnect">🔌 Déconnecter</option>
        }
        
        @if (ShowPerroquetOption)
        {
            <option value="perroquet">🦜 Perroquet (Mode Test)</option>
        }
        
        @if (Salons != null && Salons.Any())
        {
            <optgroup label="Salons disponibles">
                @foreach (var salon in Salons.Where(s => !s.IsDeleted).OrderBy(s => s.Name))
                {
                    <option value="@salon.Id">
                        @if (salon.IsDefault)
                        {
                            <text>🏠 </text>
                        }
                        @salon.Name
                        @if (salon.IsActive)
                        {
                            <text> (Actif)</text>
                        }
                    </option>
                }
            </optgroup>
        }
    </select>
</div>

@code {
    /// <summary>
    /// Liste des salons disponibles
    /// </summary>
    [Parameter]
    public IEnumerable<SalonAggregate>? Salons { get; set; }

    /// <summary>
    /// ID du salon sélectionné
    /// </summary>
    [Parameter]
    public string? SelectedSalonId { get; set; }

    /// <summary>
    /// Callback appelé lors du changement de sélection
    /// </summary>
    [Parameter]
    public EventCallback<string> OnSelectionChanged { get; set; }

    /// <summary>
    /// Label du dropdown
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "Sélectionner un salon";

    /// <summary>
    /// Affiche l'option "Déconnecter"
    /// </summary>
    [Parameter]
    public bool ShowDisconnectOption { get; set; } = true;

    /// <summary>
    /// Affiche l'option "Perroquet"
    /// </summary>
    [Parameter]
    public bool ShowPerroquetOption { get; set; } = true;

    /// <summary>
    /// Désactive le dropdown
    /// </summary>
    [Parameter]
    public bool IsDisabled { get; set; }

    /// <summary>
    /// Gère le changement de sélection
    /// </summary>
    private async Task OnSalonChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await OnSelectionChanged.InvokeAsync(value);
    }
}
