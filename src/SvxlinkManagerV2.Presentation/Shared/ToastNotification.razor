@using SvxlinkManagerV2.Presentation.Services
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@implements IDisposable

@* Composant Bootstrap 5.3 Toast pour les notifications *@

@foreach (var toast in ToastService.Toasts)
{
    <div id="toast-@toast.Id" 
         class="toast @GetToastClass(toast.Type)" 
         role="@GetAriaRole(toast.Type)" 
         aria-live="@GetAriaLive(toast.Type)" 
         aria-atomic="true"
         data-bs-autohide="@(toast.DurationMs > 0 ? "true" : "false")"
         data-bs-delay="@toast.DurationMs">
        <div class="toast-header @GetHeaderClass(toast.Type)">
            <i class="@GetIconClass(toast.Type) me-2"></i>
            <strong class="me-auto">@toast.Title</strong>
            <small>@GetRelativeTime(toast.CreatedAt)</small>
            <button type="button" class="btn-close @GetCloseButtonClass(toast.Type)" @onclick="() => RemoveToast(toast.Id)" aria-label="Fermer"></button>
        </div>
        <div class="toast-body @GetBodyClass(toast.Type)">
            @toast.Message
        </div>
    </div>
}

@code {
    private System.Collections.Generic.HashSet<Guid> _initializedToasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToastAdded += OnToastChanged;
        ToastService.OnToastRemoved += OnToastChanged;
    }

    private void OnToastChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialiser uniquement les nouveaux toasts
        foreach (var toast in ToastService.Toasts)
        {
            if (!_initializedToasts.Contains(toast.Id))
            {
                _initializedToasts.Add(toast.Id);
                
                try
                {
                    var toastIdString = $"toast-{toast.Id}";
                    var durationMs = toast.DurationMs;
                    
                    // Appeler une fonction JavaScript inline simple
                    await JSRuntime.InvokeVoidAsync("showToast", toastIdString, durationMs);
                }
                catch (Exception)
                {
                    // Ignorer les erreurs JS (par exemple si Bootstrap n'est pas encore chargé)
                }
            }
        }
        
        // Nettoyer les toasts qui ne sont plus dans la liste
        _initializedToasts.RemoveWhere(id => !ToastService.Toasts.Any(t => t.Id == id));
    }

    private void RemoveToast(Guid toastId)
    {
        _initializedToasts.Remove(toastId);
        ToastService.Remove(toastId);
    }

    private string GetToastClass(ToastType type)
    {
        return type switch
        {
            ToastType.Success => "border-success",
            ToastType.Error => "border-danger",
            ToastType.Info => "border-info",
            ToastType.Warning => "border-warning",
            _ => ""
        };
    }

    private string GetHeaderClass(ToastType type)
    {
        return type switch
        {
            ToastType.Success => "bg-success text-white",
            ToastType.Error => "bg-danger text-white",
            ToastType.Info => "bg-info text-white",
            ToastType.Warning => "bg-warning text-dark",
            _ => ""
        };
    }

    private string GetBodyClass(ToastType type)
    {
        return type switch
        {
            ToastType.Success => "bg-dark-card text-light",
            ToastType.Error => "bg-dark-card text-light",
            ToastType.Info => "bg-dark-card text-light",
            ToastType.Warning => "bg-dark-card text-dark",
            _ => "bg-dark-card text-light"
        };
    }

    private string GetCloseButtonClass(ToastType type)
    {
        return type == ToastType.Warning ? "btn-close-black" : "btn-close-white";
    }

    private string GetIconClass(ToastType type)
    {
        return type switch
        {
            ToastType.Success => "bi bi-check-circle-fill",
            ToastType.Error => "bi bi-x-circle-fill",
            ToastType.Info => "bi bi-info-circle-fill",
            ToastType.Warning => "bi bi-exclamation-circle-fill",
            _ => "bi bi-info-circle-fill"
        };
    }

    private string GetAriaRole(ToastType type)
    {
        return type is ToastType.Error or ToastType.Warning ? "alert" : "status";
    }

    private string GetAriaLive(ToastType type)
    {
        return type is ToastType.Error or ToastType.Warning ? "assertive" : "polite";
    }

    private string GetRelativeTime(DateTime createdAt)
    {
        var elapsed = DateTime.Now - createdAt;
        if (elapsed.TotalSeconds < 60) return "À l'instant";
        if (elapsed.TotalMinutes < 60) return $"Il y a {(int)elapsed.TotalMinutes} min";
        return $"Il y a {(int)elapsed.TotalHours}h";
    }

    public void Dispose()
    {
        ToastService.OnToastAdded -= OnToastChanged;
        ToastService.OnToastRemoved -= OnToastChanged;
        _initializedToasts.Clear();
    }
}
