@inject IJSRuntime JSRuntime

@* Composant Modal Bootstrap 5.3 pour confirmation d'actions *@

@if (_isVisible)
{
    <div class="modal fade show" id="@_modalId" tabindex="-1" aria-labelledby="@(_modalId)Label" aria-modal="true" role="dialog" style="display: block;">
        <div class="modal-dialog @SizeClass">
            <div class="modal-content">
                <div class="modal-header @HeaderClass">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <i class="bi bi-@Icon me-2"></i>
                    }
                    <h5 class="modal-title" id="@(_modalId)Label">@Title</h5>
                    <button type="button" class="btn-close @CloseButtonClass" @onclick="Cancel" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    @Message
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">
                        @CancelButtonText
                    </button>
                    <button type="button" class="@ConfirmButtonClasses" @onclick="Confirm">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        else if (!string.IsNullOrEmpty(ConfirmIcon))
                        {
                            <i class="bi bi-@ConfirmIcon me-2"></i>
                        }
                        @ConfirmButtonText
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private string _modalId = $"modal-{Guid.NewGuid():N}";
    private bool _isVisible;
    private bool _isProcessing;

    /// <summary>
    /// Titre du modal
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Confirmation";

    /// <summary>
    /// Message à afficher dans le corps du modal
    /// </summary>
    [Parameter]
    public RenderFragment? Message { get; set; }

    /// <summary>
    /// Icône Bootstrap Icons à afficher dans le header (sans préfixe "bi-")
    /// </summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Type de modal (danger, warning, success, info)
    /// </summary>
    [Parameter]
    public ConfirmModalType Type { get; set; } = ConfirmModalType.Danger;

    /// <summary>
    /// Taille du modal (sm, default, lg, xl)
    /// </summary>
    [Parameter]
    public ConfirmModalSize Size { get; set; } = ConfirmModalSize.Default;

    /// <summary>
    /// Texte du bouton de confirmation
    /// </summary>
    [Parameter]
    public string ConfirmButtonText { get; set; } = "Confirmer";

    /// <summary>
    /// Icône du bouton de confirmation (sans préfixe "bi-")
    /// </summary>
    [Parameter]
    public string? ConfirmIcon { get; set; }

    /// <summary>
    /// Texte du bouton d'annulation
    /// </summary>
    [Parameter]
    public string CancelButtonText { get; set; } = "Annuler";

    /// <summary>
    /// Callback appelé lors de la confirmation
    /// </summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Callback appelé lors de l'annulation
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string HeaderClass => Type switch
    {
        ConfirmModalType.Danger => "bg-danger text-white",
        ConfirmModalType.Warning => "bg-warning",
        ConfirmModalType.Success => "bg-success text-white",
        ConfirmModalType.Info => "bg-info text-white",
        _ => ""
    };

    private string CloseButtonClass => Type switch
    {
        ConfirmModalType.Danger => "btn-close-white",
        ConfirmModalType.Success => "btn-close-white",
        ConfirmModalType.Info => "btn-close-white",
        _ => ""
    };

    private string ConfirmButtonClasses => Type switch
    {
        ConfirmModalType.Danger => "btn btn-danger",
        ConfirmModalType.Warning => "btn btn-warning",
        ConfirmModalType.Success => "btn btn-success",
        ConfirmModalType.Info => "btn btn-info text-white",
        _ => "btn btn-primary"
    };

    private string SizeClass => Size switch
    {
        ConfirmModalSize.Small => "modal-sm",
        ConfirmModalSize.Large => "modal-lg",
        ConfirmModalSize.ExtraLarge => "modal-xl",
        _ => ""
    };

    /// <summary>
    /// Affiche le modal
    /// </summary>
    public void Show()
    {
        _isVisible = true;
        _isProcessing = false;
        StateHasChanged();
    }

    /// <summary>
    /// Masque le modal
    /// </summary>
    public void Hide()
    {
        _isVisible = false;
        _isProcessing = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        _isProcessing = true;
        StateHasChanged();

        await OnConfirm.InvokeAsync();
        Hide();
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
        Hide();
    }
}
