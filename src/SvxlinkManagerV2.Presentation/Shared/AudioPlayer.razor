@* Composant player audio HTML5 avec prévisualisation Bootstrap 5.3 *@

<div class="audio-player @(IsExpanded ? "" : "d-none")">
    <div class="p-3 bg-light border rounded">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(AudioDataUri))
            {
                <audio 
                    id="@_playerId" 
                    controls 
                    class="flex-grow-1"
                    style="max-width: 100%;">
                    <source src="@AudioDataUri" type="audio/wav">
                    Votre navigateur ne supporte pas l'élément audio.
                </audio>
            }
            else
            {
                <div class="text-muted flex-grow-1">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    Aucun fichier audio disponible
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _playerId = $"audio-player-{Guid.NewGuid():N}";

    /// <summary>
    /// Data URI du fichier audio (format: data:audio/wav;base64,...)
    /// </summary>
    [Parameter]
    public string AudioDataUri { get; set; } = string.Empty;

    /// <summary>
    /// Indique si le player est visible (expanded)
    /// </summary>
    [Parameter]
    public bool IsExpanded { get; set; }

    /// <summary>
    /// Callback appelé lorsque l'état d'expansion change
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsExpandedChanged { get; set; }
}
