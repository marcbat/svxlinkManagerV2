@* Composant Bootstrap 5.3 pour afficher une Alert informative *@

<div class="alert alert-@Type d-flex align-items-center @CssClass" role="alert">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="bi bi-@Icon me-2"></i>
    }
    <div>
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Type d'alerte Bootstrap : info, warning, danger, success
    /// </summary>
    [Parameter]
    public string Type { get; set; } = "info";

    /// <summary>
    /// Icône Bootstrap Icons (sans préfixe "bi-")
    /// </summary>
    [Parameter]
    public string Icon { get; set; } = "info-circle";

    /// <summary>
    /// Classes CSS supplémentaires
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Contenu HTML de l'alerte
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
