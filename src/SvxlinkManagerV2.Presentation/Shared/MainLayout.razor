@inherits LayoutComponentBase

<div class="d-flex" style="height: 100vh;">
    <!-- Sidebar -->
    <div class="bg-dark text-white" style="width: 250px; flex-shrink: 0;">
        <NavMenu />
    </div>

    <!-- Main Content Area -->
    <div class="flex-grow-1 d-flex flex-column bg-dark-custom">
        <!-- Header Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-header border-bottom border-secondary">
            <div class="container-fluid">
                <span class="navbar-brand mb-0 h1 text-light">
                    <i class="bi bi-broadcast"></i> SvxLink Manager V2
                </span>
                <div class="ms-auto text-light small">
                    <i class="bi bi-person-circle"></i> Utilisateur
                </div>
            </div>
        </nav>

        <!-- Content -->
        <main class="flex-grow-1 overflow-auto bg-dark-main">
            <div class="container-fluid p-4">
                @Body
            </div>
        </main>

        <!-- Footer -->
        <footer class="border-top border-secondary py-3 bg-dark-footer">
            <div class="container-fluid text-center text-light small opacity-75">
                SvxLink Manager V2 - Version 2.0.0-alpha
            </div>
        </footer>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <ToastNotification />
</div>
