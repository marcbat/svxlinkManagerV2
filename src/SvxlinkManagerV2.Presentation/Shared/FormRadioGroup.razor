@typeparam TValue where TValue : notnull

@* Composant Bootstrap 5.3 pour un groupe de radio buttons *@

<div class="@CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label">@Label</label>
    }
    
    <div class="@(Inline ? "d-flex gap-3" : "")">
        @foreach (var option in Options)
        {
            <div class="form-check @(Inline ? "form-check-inline" : "")">
                <input 
                    class="form-check-input" 
                    type="radio" 
                    name="@Name" 
                    id="@($"{Name}_{option.Key}")" 
                    value="@option.Key"
                    checked="@(EqualityComparer<TValue>.Default.Equals(option.Key, SelectedValue))"
                    @onchange="@(() => OnValueChanged(option.Key))" />
                <label class="form-check-label" for="@($"{Name}_{option.Key}")">
                    @option.Value
                </label>
            </div>
        }
    </div>
    
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="form-text text-muted">@HelpText</div>
    }
</div>

@code {
    /// <summary>
    /// Label du groupe de radio buttons
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Nom unique du groupe radio (attribut name)
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = null!;

    /// <summary>
    /// Dictionnaire des options : Clé → Label affiché
    /// </summary>
    [Parameter, EditorRequired]
    public Dictionary<TValue, string> Options { get; set; } = null!;

    /// <summary>
    /// Valeur sélectionnée
    /// </summary>
    [Parameter]
    public TValue? SelectedValue { get; set; }

    /// <summary>
    /// Callback quand la valeur change
    /// </summary>
    [Parameter]
    public EventCallback<TValue> SelectedValueChanged { get; set; }

    /// <summary>
    /// Affichage horizontal (inline) ou vertical
    /// </summary>
    [Parameter]
    public bool Inline { get; set; } = true;

    /// <summary>
    /// Texte d'aide affiché sous le groupe
    /// </summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>
    /// Classes CSS supplémentaires pour le container
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = "mb-3";

    private async Task OnValueChanged(TValue newValue)
    {
        SelectedValue = newValue;
        await SelectedValueChanged.InvokeAsync(newValue);
    }
}
