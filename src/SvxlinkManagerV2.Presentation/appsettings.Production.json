{
  "ConnectionStrings": {
    "SQLite": "Data Source=/opt/svxlinkmanagerv2/data/svxlinkmanager.db"
  },
  "SA818": {
    "UseMock": false
  },
  "SvxLink": {
    "UseMockDaemon": false
  },
  "SystemControl": {
    "Enabled": true,
    "UseMock": false,
    "RebootCommand": "systemctl reboot",
    "ShutdownCommand": "systemctl poweroff",
    "DelayBeforeCommandSeconds": 3
  },
  "ApplicationUpdate": {
    "Enabled": true,
    "Owner": "marcbat",
    "Repository": "svxlinkManagerV2",
    "GitHubToken": "",
    "PackagePattern": ".deb",
    "Channel": "Stable",
    "StagingDirectory": "/opt/svxlinkmanagerv2/data/updates",
    "InstallCommand": "/opt/svxlinkmanagerv2/install-update.sh",
    "InstallArguments": "{packagePath}",
    "InstallCommandTimeoutSeconds": 300
  }
}
