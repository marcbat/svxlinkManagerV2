{
  "ConnectionStrings": {
    "SQLite": "Data Source=svxlinkmanager-dev.db"
  },
  "SA818": {
    "UseMock": true
  },
  "SvxLink": {
    "UseMockDaemon": true
  },
  "Wifi": {
    "UseMock": true
  },
  "Audio": {
    "UseMock": true
  },
  "SystemControl": {
    "Enabled": true,
    "UseMock": false,
    "RebootCommand": "systemctl reboot",
    "ShutdownCommand": "systemctl poweroff",
    "DelayBeforeCommandSeconds": 3
  },
  "ApplicationUpdate": {
    "Enabled": false,
    "DefaultChannel": "Development"
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "SvxlinkManagerV2.Infrastructure": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
