[Unit]
Description=SvxlinkManager V2
After=network.target

[Service]
# Aucun User=/Group= : le service tourne en root. C'est requis par l'accès au port série
# du SA818, par nmcli, par le pilotage des daemons SVXLink, par apt-get et systemd-run
# et par les actions d'alimentation de l'interface (systemctl reboot / systemctl poweroff).
# Ne pas dégrader les privilèges sans fournir les règles polkit correspondantes.
Type=simple
TimeoutStartSec=300
WorkingDirectory=/opt/svxlinkmanagerv2
ExecStart=/usr/share/dotnet/dotnet /opt/svxlinkmanagerv2/SvxlinkManagerV2.Presentation.dll
SyslogIdentifier=svxlinkmanagerv2
Restart=always
RestartSec=10
KillMode=process
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:80
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_NOLOGO=true
# Fichier de secrets historique, conservé et optionnel (préfixe '-') : il ne portait
# que le token GitHub des mises à jour OTA, devenu inutile depuis le passage à APT.
# Les installations existantes le gardent sans effet ; il n'est plus créé.
EnvironmentFile=-/etc/svxlinkmanagerv2/secrets.env
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
