#!/bin/sh
# postinst — script exécuté après l'installation/mise à jour du paquet .deb
# Toutes les étapes sont logguées dans $LOG_FILE pour diagnostic post-mortem.

APP_DIR="/opt/svxlinkmanagerv2"
SERVICE_NAME="svxlinkmanagerv2"
PACKAGE_NAME="svxlinkmanagerv2"
LOG_DIR="$APP_DIR/logs"
LOG_FILE="$LOG_DIR/postinst.log"
APT_KEYRING="/etc/apt/keyrings/svxlinkmanager.gpg"
APT_SOURCE="/etc/apt/sources.list.d/svxlinkmanager.list"
APT_REPOSITORY_URL="https://marcbat.github.io/svxlinkManagerV2"

mkdir -p "$LOG_DIR"

log() {
  printf '%s [postinst] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$LOG_FILE"
}

log_and_echo() {
  log "$1"
  echo "$1"
}

fail() {
  log "ERREUR FATALE: $1"
  echo "ERREUR: $1" >&2
  exit 1
}

get_installed_package_version() {
  if command -v dpkg-query >/dev/null 2>&1; then
    version="$(dpkg-query -W -f='${Version}' "$PACKAGE_NAME" 2>>"$LOG_FILE" || true)"
    if [ -n "$version" ]; then
      printf '%s' "$version"
      return
    fi
  fi

  if [ -f "$APP_DIR/version.txt" ]; then
    version="$(cat "$APP_DIR/version.txt" 2>>"$LOG_FILE" || true)"
    if [ -n "$version" ]; then
      printf '%s' "$version"
      return
    fi
  fi

  printf ''
}

# Créer un répertoire de manière robuste : si le chemin existe en tant que fichier,
# le supprimer avant de créer le répertoire.
ensure_directory() {
  target="$1"
  if [ -e "$target" ] && [ ! -d "$target" ]; then
    log "ATTENTION: $target existe mais n'est pas un répertoire, suppression"
    rm -f "$target"
  fi
  mkdir -p "$target" 2>>"$LOG_FILE"
}

# Installe la clé de signature et la source APT du projet.
# C'est ce qui permet aux nœuds installés avant la bascule vers apt de basculer sans
# intervention : le premier paquet posé à la main amorce le dépôt, les suivants passent
# par « apt upgrade ». La source n'est écrite que si elle est absente — le canal est
# ensuite piloté depuis l'interface, qui réécrit ce fichier.
ensure_apt_repository() {
  if [ -f "$APP_DIR/svxlinkmanager.gpg" ]; then
    mkdir -p /etc/apt/keyrings
    cp "$APP_DIR/svxlinkmanager.gpg" "$APT_KEYRING"
    chmod 0644 "$APT_KEYRING"
    chown root:root "$APT_KEYRING"
    log "Clé de signature du dépôt APT installée : $APT_KEYRING"
  else
    log "ATTENTION: clé de signature absente du paquet, dépôt APT non configuré"
    return
  fi

  if [ ! -f "$APT_SOURCE" ]; then
    mkdir -p /etc/apt/sources.list.d
    cat > "$APT_SOURCE" <<EOF
# Fichier géré par SvxlinkManagerV2 — toute modification manuelle sera écrasée
# lors du prochain changement de canal depuis l'interface.
deb [arch=armhf signed-by=$APT_KEYRING] $APT_REPOSITORY_URL stable main
EOF
    chmod 0644 "$APT_SOURCE"
    log "Source APT créée sur le canal stable : $APT_SOURCE"
  else
    log "Source APT déjà présente, canal préservé : $APT_SOURCE"
  fi
}

package_version="$(get_installed_package_version)"
if [ -n "$package_version" ]; then
  log "========== Début postinst version $package_version =========="
else
  log "========== Début postinst version inconnue =========="
fi

mkdir -p "$APP_DIR/data"
log "Répertoire data créé/vérifié"

# --- Dépôt APT : clé de signature et source ---
ensure_apt_repository

# La base SQLite est TOUJOURS préservée : le schéma est mis à niveau au démarrage
# de l'application par les migrations EF Core (DatabaseMigrator), y compris pour une
# base créée avant leur introduction. Ne jamais réintroduire de suppression ici :
# elle détruirait les salons et la configuration de l'utilisateur.
log "Base SQLite préservée (mise à niveau du schéma par les migrations EF Core au démarrage)"

# --- Répertoires SVXLink requis par les deux versions ---
log "Création des répertoires SVXLink..."
ensure_directory /var/spool/svxlink
ensure_directory /var/log/svxlink
ensure_directory /var/lib/svxlink/pki/pending_csrs
ensure_directory /var/lib/svxlink/pki/csrs
ensure_directory /var/lib/svxlink/pki/certs
ensure_directory /var/lib/svxlink/pki/ca
ensure_directory /etc/svxlink
ensure_directory /etc/svxlink/svxlink.d

# Template de configuration SVXLink (requis par SvxLinkConfigurationService)
if [ -f "$APP_DIR/svxlink-config/svxlink.conf" ] && [ ! -f /etc/svxlink/svxlink.conf ]; then
  cp "$APP_DIR/svxlink-config/svxlink.conf" /etc/svxlink/svxlink.conf
  log "Template svxlink.conf copié vers /etc/svxlink/"
fi

# Répertoires sons pour les deux versions SVXLink
ensure_directory /opt/svxlink-legacy/share/svxlink/sounds/fr_FR/svxlinkmanager
ensure_directory /opt/svxlink-modern/share/svxlink/sounds/fr_FR/svxlinkmanager
ensure_directory /opt/svxlink-legacy/share/svxlink/events.d/local
ensure_directory /opt/svxlink-modern/share/svxlink/events.d/local
log "Répertoires sons et events créés"

# --- Enregistrement des bibliothèques partagées SVXLink ---
if [ -d /opt/svxlink-legacy/lib ]; then
  echo "/opt/svxlink-legacy/lib" > /etc/ld.so.conf.d/svxlink-legacy.conf
fi
if [ -d /opt/svxlink-modern/lib ]; then
  echo "/opt/svxlink-modern/lib" > /etc/ld.so.conf.d/svxlink-modern.conf
fi
ldconfig 2>/dev/null || true
log "ldconfig exécuté"

# --- Hook de signature automatique des certificats X.509 (SVXLink 25.05 / protocole V3) ---
HOOK_SRC="$APP_DIR/dev-ca-hook.sh"
HOOK_DST="/usr/local/bin/dev-ca-hook.sh"
if [ -f "$HOOK_SRC" ]; then
  cp "$HOOK_SRC" "$HOOK_DST"
  chmod +x "$HOOK_DST"
  log "Hook X.509 installé"
fi

# --- Vérification des installations SVXLink ---
if [ ! -f /opt/svxlink-legacy/bin/svxlink ]; then
  log_and_echo "ATTENTION: SVXLink 19.09.2 (legacy) introuvable dans /opt/svxlink-legacy."
  log_and_echo "  Exécutez le script de setup: $APP_DIR/setup-svxlink.sh"
fi
if [ ! -f /opt/svxlink-modern/bin/svxlink ]; then
  log_and_echo "ATTENTION: SVXLink 25.05 (moderne) introuvable dans /opt/svxlink-modern."
  log_and_echo "  Exécutez le script de setup: $APP_DIR/setup-svxlink.sh"
fi

# --- Vérification .NET runtime ---
DOTNET_BIN=""
for candidate in dotnet /usr/local/bin/dotnet /usr/bin/dotnet /usr/share/dotnet/dotnet; do
  if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then
    DOTNET_BIN="$candidate"
    break
  fi
done

if [ -z "$DOTNET_BIN" ]; then
  fail "dotnet runtime est introuvable. Installe .NET 8 runtime (linux-arm) avant de lancer le service."
fi

if ! "$DOTNET_BIN" --list-runtimes 2>/dev/null | grep -q '^Microsoft.NETCore.App 8\.'; then
  log "Runtimes .NET détectés:"
  "$DOTNET_BIN" --list-runtimes 2>>"$LOG_FILE" >> "$LOG_FILE" || true
  fail ".NET 8 runtime est requis mais absent."
fi
log ".NET 8 runtime détecté: $DOTNET_BIN"

chmod +x "$APP_DIR/SvxlinkManagerV2.Presentation" 2>/dev/null || true

if command -v systemctl >/dev/null 2>&1; then
  log "Activation et redémarrage du service $SERVICE_NAME..."
  systemctl daemon-reload >> "$LOG_FILE" 2>&1 || true
  systemctl enable "$SERVICE_NAME" >> "$LOG_FILE" 2>&1 || true
  systemctl restart "$SERVICE_NAME" >> "$LOG_FILE" 2>&1 || true
  log "Service $SERVICE_NAME redémarré"
else
  log "ATTENTION: systemctl indisponible, le service n'a pas été redémarré"
fi

log "========== Fin postinst (succès) =========="
